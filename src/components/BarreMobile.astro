---
/**
 * Petit dock flottant en bas de l'écran, sur mobile uniquement.
 * Il apparaît dès qu'on a quitté le haut de la page : appeler, WhatsApp
 * et devis restent toujours au pouce.
 */
import Icon from './Icon.astro';
import { entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
---

<div class="dock" data-dock>
  <a href={`tel:${entreprise.telephoneLien}`} class="dock__rond" aria-label={`${textes.actions.appeler} ${entreprise.telephoneAffiche}`}>
    <Icon nom="telephone" taille={20} />
  </a>
  <a
    href={lienWhatsApp(textes.whatsappMessage)}
    class="dock__rond dock__rond--whatsapp"
    target="_blank"
    rel="noopener"
    aria-label={textes.actions.whatsapp}
  >
    <Icon nom="whatsapp" taille={21} />
  </a>
  <a href={lienDevis(langue)} class="dock__devis">
    {textes.actions.devis}
    <span class="dock__pastille" aria-hidden="true"><Icon nom="fleche-diag" taille={16} epaisseur={2.2} /></span>
  </a>
</div>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  if (dock) {
    const mettreAJour = () => {
      const bas = window.innerHeight + window.scrollY >= document.body.scrollHeight - 40;
      dock.classList.toggle('dock--visible', window.scrollY > window.innerHeight * 0.5 && !bas);
    };
    window.addEventListener('scroll', mettreAJour, { passive: true });
    mettreAJour();
  }
</script>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    background: rgba(18, 20, 24, 0.92);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transform: translate(-50%, 140%);
    transition: transform 600ms var(--ease-out);
  }

  .dock--visible {
    transform: translate(-50%, 0);
  }

  .dock__rond {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(245, 242, 236, 0.1);
    color: var(--color-on-ink);
  }

  .dock__rond--whatsapp {
    background: var(--color-whatsapp);
    color: #fff;
  }

  .dock__devis {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 50px;
    padding: 0 6px 0 18px;
    border-radius: var(--radius-pill);
    background: var(--color-signal);
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .dock__pastille {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-signal);
  }

  :global(body.menu-ouvert) .dock {
    display: none;
  }

  @media (min-width: 1024px) {
    .dock {
      display: none;
    }
  }
</style>
