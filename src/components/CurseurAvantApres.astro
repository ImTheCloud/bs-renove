---
/**
 * Curseur avant / après : l'élément marquant du site.
 *
 * Construit autour d'un vrai <input type="range"> : il marche donc
 * à la souris, au doigt ET au clavier (flèches gauche/droite), sans
 * une ligne de code en plus. Aucune librairie externe.
 *
 * Il affiche une paire de src/data/projets.ts (photos, cadrage, format).
 */
import { Image } from 'astro:assets';
import type { Paire } from '~/data/projets';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
  paire: Paire;
  /** Taille affichée, pour que le navigateur charge la bonne image. */
  sizes: string;
  /** Position de départ de la poignée, en % (celle de la paire sinon). */
  depart?: number;
  /** En haut de page : chargé tout de suite, en priorité (sinon en différé). */
  prioritaire?: boolean;
  /** Si la même paire apparaît deux fois sur la page (ex. dans la maison). */
  idSuffixe?: string;
}

const { langue, paire, sizes, depart = paire.depart, prioritaire = false, idSuffixe = '' } = Astro.props;
const avantApres = t(langue).accueil.avantApres;
const dp = t(langue).deuxPoints;
const id = `curseur-${paire.id.replace('/', '-')}${idSuffixe}`;
const aideId = `${id}-aide`;
const legende = paire.legende[langue];
const photo = {
  // 960 px suffit même sur un grand téléphone ; qualité 62 : invisible à l'œil, bien plus léger en 4G.
  widths: [480, 720, 960],
  width: 960,
  quality: 62,
  sizes,
  loading: prioritaire ? ('eager' as const) : ('lazy' as const),
  // Priorité à l'« après » (le plus grand élément) : l'« avant » suit juste derrière.
  fetchpriority: prioritaire ? ('high' as const) : undefined,
};
---

<div class="curseur" data-curseur style={`--ratio: ${paire.ratio}; --position: ${depart}%;`}>
  <!-- Fond : la photo « après ». Elle est visible à droite du trait. -->
  <div class="curseur__couche curseur__couche--apres">
    <Image src={paire.apres} alt={`${avantApres.apres}${dp}${legende}`} style={`object-position: ${paire.cadrageApres}`} {...photo} />
  </div>

  <!-- Dessus : la photo « avant », rognée à gauche du trait. -->
  <div class="curseur__couche curseur__couche--avant">
    <Image src={paire.avant} alt={`${avantApres.avant}${dp}${legende}`} style={`object-position: ${paire.cadrageAvant}`} {...photo} fetchpriority={undefined} />
  </div>

  <span class="curseur__etiquette curseur__etiquette--avant">{avantApres.avant}</span>
  <span class="curseur__etiquette curseur__etiquette--apres">{avantApres.apres}</span>

  <!-- Le trait et la poignée : décoratifs, ils suivent la valeur du range. -->
  <div class="curseur__trait" data-trait aria-hidden="true">
    <span class="curseur__poignee">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M9 7l-5 5 5 5"></path>
        <path d="M15 7l5 5-5 5"></path>
      </svg>
    </span>
  </div>

  <label class="sr-only" for={id}>{avantApres.curseurLabel} — {legende}</label>
  <input
    type="range"
    id={id}
    class="curseur__range"
    min="0"
    max="100"
    value={String(depart)}
    step="1"
    aria-describedby={aideId}
    data-range
  />
  <p id={aideId} class="sr-only">{avantApres.curseurAide}</p>
</div>

<script>
  /*
    Chaque curseur de la page se gère tout seul.
    - Clavier : le vrai <input type="range"> (flèches gauche/droite).
    - Souris : on clique ou on fait glisser n'importe où sur la photo.
    - Doigt : on attend de savoir dans quel sens part le geste. Vertical, la page
      défile normalement ; horizontal, la poignée suit le doigt. Un doigt posé
      sur la photo ne bloque donc jamais le défilement.
  */
  const SEUIL = 8; // px avant de décider du sens du geste

  document.querySelectorAll<HTMLElement>('[data-curseur]').forEach((curseur) => {
    const range = curseur.querySelector<HTMLInputElement>('[data-range]');
    if (!range) return;

    const appliquer = () => {
      curseur.style.setProperty('--position', `${range.value}%`);
    };
    range.addEventListener('input', appliquer);
    appliquer();

    const placer = (x: number) => {
      const boite = curseur.getBoundingClientRect();
      range.value = String(Math.round(Math.min(100, Math.max(0, ((x - boite.left) / boite.width) * 100))));
      appliquer();
    };

    let geste: { id: number; x: number; y: number } | null = null;
    let glisse = false;

    const commencer = (id: number) => {
      glisse = true;
      curseur.setPointerCapture(id);
      curseur.classList.add('curseur--actif');
    };

    curseur.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      geste = { id: e.pointerId, x: e.clientX, y: e.clientY };
      glisse = false;
      if (e.pointerType === 'mouse') {
        e.preventDefault();
        commencer(e.pointerId);
        placer(e.clientX);
      }
    });

    curseur.addEventListener('pointermove', (e) => {
      if (!geste || e.pointerId !== geste.id) return;
      if (!glisse) {
        const dx = Math.abs(e.clientX - geste.x);
        const dy = Math.abs(e.clientY - geste.y);
        if (dx < SEUIL && dy < SEUIL) return;
        // Plutôt vertical : c'est un défilement, on laisse faire la page.
        if (dy >= dx) {
          geste = null;
          return;
        }
        commencer(e.pointerId);
      }
      placer(e.clientX);
    });

    const finir = (e: PointerEvent) => {
      if (!geste || e.pointerId !== geste.id) return;
      geste = null;
      glisse = false;
      curseur.classList.remove('curseur--actif');
    };
    curseur.addEventListener('pointerup', finir);
    curseur.addEventListener('pointercancel', finir);
  });
</script>

<style>
  .curseur {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-photo);
    overflow: hidden;
    /* Le navigateur garde le défilement vertical ; le geste horizontal est pour la poignée. */
    touch-action: pan-y;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  /* Les photos ne se « traînent » pas et ne captent pas le doigt. */
  .curseur :global(img) {
    pointer-events: none;
    -webkit-user-drag: none;
  }

  .curseur__couche {
    position: absolute;
    inset: 0;
  }

  .curseur__couche :global(> *) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  /* La photo « avant » n'est montrée que du bord gauche jusqu'au trait. */
  .curseur__couche--avant {
    clip-path: inset(0 calc(100% - var(--position)) 0 0);
  }

  .curseur__etiquette {
    position: absolute;
    top: 16px;
    z-index: 2;
    padding: 7px 14px;
    background: rgba(245, 242, 236, 0.92);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    pointer-events: none;
    backdrop-filter: blur(6px);
  }

  .curseur__etiquette--avant {
    left: 16px;
  }

  .curseur__etiquette--apres {
    right: 16px;
  }

  .curseur__trait {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    z-index: 3;
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    pointer-events: none;
  }

  .curseur__poignee {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    transform: translate(-50%, -50%);
    background: var(--color-signal);
    border: 3px solid #fff;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    box-shadow: var(--shadow-float);
    transition: transform 300ms var(--ease-out);
  }

  .curseur:hover .curseur__poignee,
  .curseur.curseur--actif .curseur__poignee {
    transform: translate(-50%, -50%) scale(1.1);
  }

  /*
    Le vrai <input> est invisible mais couvre toute l'image :
    c'est lui qu'on manipule à la souris, au doigt et au clavier.
  */
  /*
    Le vrai <input> reste là pour le clavier et les lecteurs d'écran, mais ne capte
    plus le doigt ni la souris (c'est le script qui s'en charge) : sur iPhone,
    il bloquait le défilement de la page dès qu'on touchait la photo.
  */
  .curseur__range {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
    appearance: none;
    pointer-events: none;
  }

  .curseur__range::-webkit-slider-thumb {
    appearance: none;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: ew-resize;
  }

  .curseur__range::-moz-range-thumb {
    width: 56px;
    height: 56px;
    border: none;
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: ew-resize;
  }

  /* Au clavier, l'anneau de focus se dessine autour de l'image entière. */
  .curseur__range:focus {
    outline: none;
  }

  .curseur:has(.curseur__range:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 599px) {
    .curseur__poignee {
      width: 48px;
      height: 48px;
    }

    .curseur__etiquette {
      top: 12px;
      padding: 6px 12px;
    }

    .curseur__etiquette--avant {
      left: 12px;
    }

    .curseur__etiquette--apres {
      right: 12px;
    }
  }
</style>
