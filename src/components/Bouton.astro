---
/**
 * Bouton en forme de pilule. Toujours un vrai <a> (lien) ou <button> (action).
 * La flèche finale vit dans une pastille ronde qui s'anime au survol.
 */
import Icon, { type NomIcone } from './Icon.astro';

type Variante =
  | 'principal'
  | 'secondaire'
  | 'signal'
  | 'ink-principal'
  | 'ink-secondaire'
  | 'whatsapp';

interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variante?: Variante;
  icone?: NomIcone;
  iconeApres?: NomIcone;
  large?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variante = 'principal',
  icone,
  iconeApres,
  large = false,
  class: classe,
  ...reste
} = Astro.props;

const Element = href ? 'a' : 'button';
const attributs = href ? { href } : { type };
const classes = [
  'bouton',
  `bouton--${variante}`,
  large && 'bouton--large',
  iconeApres && 'bouton--pastille',
  classe,
];
---

<Element class:list={classes} {...attributs} {...reste}>
  {icone && <Icon nom={icone} taille={20} />}
  <span class="bouton__texte"><slot /></span>
  {
    iconeApres && (
      <span class="bouton__pastille" aria-hidden="true">
        <Icon nom={iconeApres} taille={18} epaisseur={2} />
      </span>
    )
  }
</Element>

<style>
  .bouton {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: var(--size-small);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    isolation: isolate;
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      color var(--speed) var(--ease),
      transform var(--speed) var(--ease);
  }

  .bouton--pastille {
    padding-right: 6px;
    gap: 16px;
  }

  .bouton--large {
    min-height: 60px;
    padding-inline: 30px;
    font-size: var(--size-body);
  }

  .bouton--large.bouton--pastille {
    padding-right: 7px;
  }

  .bouton:active {
    transform: scale(0.98);
  }

  .bouton__pastille {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-signal);
    color: var(--color-ink);
    transition: transform 420ms var(--ease-out);
  }

  .bouton--large .bouton__pastille {
    width: 46px;
    height: 46px;
  }

  .bouton:hover .bouton__pastille {
    transform: rotate(-45deg) scale(1.06);
  }

  /* Bleu du logo : le bouton principal, partout sur fond clair. */
  .bouton--principal {
    background: var(--color-accent);
    color: #fff;
  }

  .bouton--principal:hover {
    background: var(--color-accent-dark);
  }

  .bouton--secondaire {
    background: transparent;
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .bouton--secondaire .bouton__pastille {
    background: var(--color-accent);
    color: #fff;
  }

  .bouton--secondaire:hover {
    background: var(--color-accent);
    color: #fff;
  }

  .bouton--secondaire:hover .bouton__pastille {
    background: var(--color-signal);
    color: var(--color-ink);
  }

  .bouton--signal {
    background: var(--color-signal);
    color: var(--color-ink);
  }

  .bouton--signal .bouton__pastille {
    background: var(--color-ink);
    color: var(--color-signal);
  }

  .bouton--signal:hover {
    background: #ffcb1f;
  }

  /* Sur fond encre */
  .bouton--ink-principal {
    background: var(--color-on-ink);
    color: var(--color-ink);
  }

  .bouton--ink-principal:hover {
    background: #fff;
  }

  .bouton--ink-secondaire {
    background: transparent;
    border-color: rgba(245, 242, 236, 0.35);
    color: var(--color-on-ink);
  }

  .bouton--ink-secondaire:hover {
    background: rgba(245, 242, 236, 0.1);
    border-color: rgba(245, 242, 236, 0.6);
  }

  .bouton--whatsapp {
    background: var(--color-whatsapp);
    color: #fff;
  }

  .bouton--whatsapp:hover {
    background: var(--color-whatsapp-dark);
  }

  .bouton--whatsapp .bouton__pastille {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }
</style>
