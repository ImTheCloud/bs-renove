---
/**
 * Pied de page : un appel au devis, les liens et infos utiles, puis le logo
 * et les mentions légales.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SelecteurLangue from './SelecteurLangue.astro';
import { adresseUneLigne, entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { chemin, liensNavigation, t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  cheminActuel: string;
}

const { langue, cheminActuel } = Astro.props;
const textes = t(langue);
const liens = liensNavigation(langue);
const annee = 2026;
---

<footer class="pied">
  <div class="wrap pied__haut">
    <div class="pied__appel">
      <p class="pied__phrase">{textes.piedDePage.projet}</p>
      <a href={lienDevis(langue)} class="pied__grand-lien">
        {textes.actions.devis}
        <span class="pied__fleche" aria-hidden="true"><Icon nom="fleche-diag" taille={26} epaisseur={2} /></span>
      </a>
    </div>

    <div class="pied__colonnes">
      <nav class="pied__col" aria-label={textes.entete.menuAria}>
        <span class="pied__titre">Menu</span>
        {liens.map((lien) => <a href={lien.href}>{lien.libelle}</a>)}
        <a href={chemin('rejoindre', langue)}>{textes.piedDePage.rejoindre}</a>
      </nav>

      <div class="pied__col">
        <span class="pied__titre">{textes.entete.contactDirect}</span>
        <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephoneAffiche}</a>
        <a href={lienWhatsApp(textes.whatsappMessage)} target="_blank" rel="noopener">WhatsApp ↗</a>
        {entreprise.email && <a href={`mailto:${entreprise.email}`} class="pied__email">{entreprise.email}</a>}
      </div>

      <div class="pied__col">
        <span class="pied__titre">{entreprise.nomLegal}</span>
        <span>{adresseUneLigne}</span>
        <span>{textes.piedDePage.tva} {entreprise.tva}</span>
        <div class="pied__langues">
          <SelecteurLangue langue={langue} cheminActuel={cheminActuel} />
        </div>
      </div>
    </div>
  </div>

  <div class="wrap pied__bas">
    <a href={chemin('accueil', langue)} class="pied__logo" aria-label={textes.entete.accueilAria}>
      <Logo />
    </a>
    <p>© {annee} {entreprise.nomLegal}. {textes.piedDePage.droits}</p>
    <nav class="pied__legal" aria-label={textes.piedDePage.mentionsLegales}>
      <a href={chemin('mentionsLegales', langue)}>{textes.piedDePage.mentionsLegales}</a>
      <a href={chemin('viePrivee', langue)}>{textes.piedDePage.viePrivee}</a>
    </nav>
  </div>
</footer>

<style>
  .pied {
    position: relative;
    margin-top: 64px;
    padding-top: 72px;
    padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  .pied__haut {
    display: grid;
    gap: 56px;
  }

  .pied__phrase {
    font-family: var(--font-main);
    font-size: 28px;
    font-weight: 600;
    color: var(--color-accent);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .pied__grand-lien {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
    font-family: var(--font-title);
    font-size: clamp(32px, 3.4vw, 48px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--color-ink);
    text-decoration: none;
    background: linear-gradient(var(--color-signal), var(--color-signal)) no-repeat 0 88% / 0% 0.28em;
    transition: background-size 600ms var(--ease-out);
  }

  .pied__grand-lien:hover {
    background-size: 100% 0.28em;
  }

  .pied__fleche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-signal);
    transition: transform 500ms var(--ease-out);
  }

  .pied__grand-lien:hover .pied__fleche {
    transform: rotate(45deg);
  }

  .pied__colonnes {
    display: grid;
    gap: 36px;
  }

  .pied__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    font-size: var(--size-small);
    color: var(--color-text);
  }

  .pied__titre {
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pied__col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-ink);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 85% / 0% 1px;
    transition: background-size 400ms var(--ease-out);
  }

  .pied__col a:hover {
    background-size: 100% 1px;
  }

  .pied__email {
    overflow-wrap: anywhere;
  }

  .pied__langues {
    margin-top: 12px;
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  .pied__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .pied__legal {
    display: flex;
    gap: 20px;
  }

  @media (min-width: 700px) {
    .pied__legal {
      margin-left: auto;
    }
  }

  .pied__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }

  .pied__legal a:hover {
    color: var(--color-ink);
  }

  @media (min-width: 900px) {
    .pied {
      margin-top: 96px;
      padding-top: 96px;
    }

    .pied__haut {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 64px;
    }

    .pied__colonnes {
      grid-template-columns: repeat(3, auto);
      justify-content: end;
      gap: 56px;
    }

    .pied__phrase {
      font-size: 34px;
    }

  }

  @media (min-width: 1024px) {
    .pied {
      padding-bottom: 20px;
    }
  }
</style>
