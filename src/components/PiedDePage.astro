---
/**
 * Pied de page, sur fond papier :
 * - en haut, la bande jaune « rubalise » qui défile ;
 * - un appel au contact et les colonnes d'infos ;
 * - le logo et les mentions légales.
 */
import Bouton from './Bouton.astro';
import Logo from './Logo.astro';
import SelecteurLangue from './SelecteurLangue.astro';
import { adresseUneLigne, entreprise, lienDevis, lienWhatsApp } from '../data/entreprise';
import { chemin, liensNavigation, t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  cheminActuel: string;
}

const { langue, cheminActuel } = Astro.props;
const textes = t(langue);
const pied = textes.piedDePage;
const liens = liensNavigation(langue);
const annee = 2026;
const rubalise = [textes.actions.gratuit, 'BS Renove', textes.entete.tagline, pied.zone];
---

<footer class="pied">
  <div class="rubalise" aria-hidden="true">
    <div class="rubalise__piste">
      {
        [0, 1].map(() => (
          <div class="rubalise__groupe">
            {[...rubalise, ...rubalise].map((mot) => (
              <span class="rubalise__mot">
                {mot}
                <span class="rubalise__rayure" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap pied__haut">
    <div class="pied__appel">
      <p class="pied__phrase manuscrit">{pied.projet}</p>
      <div class="pied__actions">
        <Bouton href={lienDevis(langue)} variante="principal" iconeApres="fleche-diag" large>
          {textes.actions.devis}
        </Bouton>
        <Bouton href={lienWhatsApp(textes.whatsappMessage)} variante="whatsapp" icone="whatsapp" large target="_blank" rel="noopener">
          WhatsApp
        </Bouton>
      </div>
    </div>

    <div class="pied__colonnes">
      <nav class="pied__col" aria-label={textes.entete.menuAria}>
        <span class="pied__titre">Menu</span>
        {liens.map((lien) => <a href={lien.href}>{lien.libelle}</a>)}
        <a href={chemin('rejoindre', langue)}>{pied.rejoindre}</a>
      </nav>

      <div class="pied__col">
        <span class="pied__titre">{textes.entete.contactDirect}</span>
        <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephoneAffiche}</a>
        <a href={lienWhatsApp(textes.whatsappMessage)} target="_blank" rel="noopener">WhatsApp ↗</a>
        {entreprise.email && <a href={`mailto:${entreprise.email}`} class="pied__email">{entreprise.email}</a>}
      </div>

      <div class="pied__col">
        <span class="pied__titre">{pied.entreprise}</span>
        <span>{entreprise.nomLegal}</span>
        <span>{adresseUneLigne}</span>
        <span>{pied.tva} {entreprise.tva}</span>
        <div class="pied__langues">
          <SelecteurLangue langue={langue} cheminActuel={cheminActuel} />
        </div>
      </div>
    </div>
  </div>

  <div class="wrap pied__bas">
    <a href={chemin('accueil', langue)} class="pied__logo" aria-label={textes.entete.accueilAria}>
      <Logo />
    </a>
    <p>© {annee} {entreprise.nomLegal}. {pied.droits}</p>
    <nav class="pied__legal" aria-label={pied.mentionsLegales}>
      <a href={chemin('mentionsLegales', langue)}>{pied.mentionsLegales}</a>
      <a href={chemin('viePrivee', langue)}>{pied.viePrivee}</a>
    </nav>
  </div>
</footer>

<style>
  .pied {
    position: relative;
    margin-top: 72px;
    padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
    overflow: hidden;
  }

  /* --- La rubalise --- */
  .rubalise {
    display: flex;
    overflow: hidden;
    white-space: nowrap;
    margin-inline: -2%;
    padding-block: 10px;
    background: var(--color-signal);
    color: var(--color-ink);
    transform: rotate(-1.2deg);
  }

  .rubalise__piste {
    display: flex;
    flex-shrink: 0;
    animation: rubalise 38s linear infinite;
  }

  .rubalise__groupe {
    display: flex;
    flex-shrink: 0;
  }

  .rubalise__mot {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rubalise__rayure {
    width: 36px;
    height: 14px;
    background: repeating-linear-gradient(-45deg, var(--color-ink) 0 5px, transparent 5px 10px);
  }

  @keyframes rubalise {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rubalise__piste {
      animation: none;
    }
  }

  /* --- Haut : appel et colonnes --- */
  .pied__haut {
    display: grid;
    gap: 48px;
    padding-top: 64px;
  }

  .pied__phrase {
    font-size: 32px;
    color: var(--color-accent);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .pied__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  .pied__colonnes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
  }

  .pied__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    font-size: var(--size-small);
    color: var(--color-text);
  }

  .pied__titre {
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pied__col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-ink);
    text-decoration: none;
    background: linear-gradient(var(--color-signal), var(--color-signal)) no-repeat 0 88% / 0% 3px;
    transition: background-size 400ms var(--ease-out);
  }

  .pied__col a:hover {
    background-size: 100% 3px;
  }

  .pied__email {
    overflow-wrap: anywhere;
  }

  .pied__langues {
    margin-top: 14px;
  }

  /* --- Bas --- */
  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  .pied__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    text-decoration: none;
  }

  .pied__legal {
    display: flex;
    gap: 20px;
  }

  .pied__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-muted);
  }

  .pied__legal a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 899px) {
    .pied__col:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  @media (min-width: 700px) {
    .pied__legal {
      margin-left: auto;
    }
  }

  @media (min-width: 900px) {
    .pied {
      margin-top: 112px;
    }

    .pied__haut {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: 64px;
      padding-top: 88px;
    }

    .pied__colonnes {
      grid-template-columns: 1fr 1.2fr 1.2fr;
      gap: 40px;
    }
  }

  @media (min-width: 1024px) {
    .pied {
      padding-bottom: 24px;
    }
  }
</style>
