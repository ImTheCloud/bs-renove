---
/**
 * Affiche la vraie photo d'un projet quand elle existe, sinon le bloc
 * gris « photo à venir ». Centralise ce choix : les pages n'ont pas à
 * savoir si une photo a été reçue ou non.
 */
import { Image } from 'astro:assets';
import PhotoAVenir from './PhotoAVenir.astro';
import type { Langue } from '~/i18n';

interface Props {
  image?: ImageMetadata;
  alt: string;
  langue: Langue;
  ratio?: string;
  arrondi?: string;
  ton?: 'clair' | 'moyen' | 'fonce';
  compact?: boolean;
  class?: string;
  /** Charge tout de suite plutôt qu'en différé : réservé à la photo du hero. */
  prioritaire?: boolean;
}

const {
  image,
  alt,
  langue,
  ratio = '4 / 3',
  arrondi = 'var(--radius-card-img)',
  ton,
  compact,
  class: classe,
  prioritaire = false,
} = Astro.props;
---

{
  image ? (
    <div class:list={['photo-projet', classe]} style={`--ratio: ${ratio}; --arrondi: ${arrondi};`}>
      <Image
        src={image}
        alt={alt}
        width={1200}
        loading={prioritaire ? 'eager' : 'lazy'}
        fetchpriority={prioritaire ? 'high' : 'auto'}
      />
    </div>
  ) : (
    <PhotoAVenir langue={langue} legende={alt} ratio={ratio} arrondi={arrondi} ton={ton} compact={compact} class={classe} />
  )
}

<style>
  .photo-projet {
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: var(--arrondi);
    overflow: hidden;
  }

  .photo-projet :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
