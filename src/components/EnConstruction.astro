---
/**
 * Bloc provisoire, le temps que la page soit écrite.
 * Il disparaîtra page par page au fil des phases suivantes.
 */
import Bouton from './Bouton.astro';
import Icon from './Icon.astro';
import { entreprise, lienWhatsApp } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  titre: string;
}

const { langue, titre } = Astro.props;
const textes = t(langue);
---

<section class="wrap chantier">
  <span class="chantier__etiquette">
    <Icon nom="pin" taille={15} />
    {textes.enConstruction.etiquette}
  </span>
  <h1>{titre}</h1>
  <p class="chantier__texte">{textes.enConstruction.texte}</p>
  <div class="chantier__actions">
    <Bouton href={`tel:${entreprise.telephoneLien}`} variante="principal" icone="telephone" large>
      {entreprise.telephoneAffiche}
    </Bouton>
    <Bouton
      href={lienWhatsApp(textes.whatsappMessage)}
      variante="secondaire"
      icone="whatsapp"
      large
      target="_blank"
      rel="noopener"
    >
      {textes.actions.whatsappCourt}
    </Bouton>
  </div>
</section>

<style>
  .chantier {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 56px var(--section-gap);
    max-width: 760px;
  }

  .chantier__etiquette {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-muted);
  }

  .chantier__texte {
    font-size: var(--size-body);
    color: var(--color-text);
  }

  .chantier__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
