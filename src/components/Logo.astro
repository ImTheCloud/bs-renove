---
/** Logo de l'entreprise : icône (fond transparent) + nom. */
import { Image } from 'astro:assets';
import icone from '~/assets/marque/icone-logo.png';
import { entreprise } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  /** Sur fond ink (bloc contact, pied de page), le texte passe en blanc. */
  surFonce?: boolean;
}

const { langue, surFonce = false } = Astro.props;
const textes = t(langue);
---

<span class:list={['logo', { 'logo--fonce': surFonce }]}>
  <Image src={icone} alt="" width={96} height={96} class="logo__icone" />
  <span class="logo__texte">
    <span class="logo__nom">
      BS <span class="logo__nom-suite">Renove</span>
    </span>
    <span class="logo__tagline">{textes.entete.tagline}</span>
  </span>
  <span class="sr-only">{entreprise.nomLegal}</span>
</span>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }

  .logo__icone {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .logo__texte {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .logo__nom {
    font-family: var(--font-title);
    font-size: 21px;
    font-weight: 750;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    transition: color 400ms var(--ease);
  }

  .logo__nom-suite {
    font-weight: 500;
    color: inherit;
    opacity: 0.62;
  }

  .logo__tagline {
    font-size: 10.5px;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 400ms var(--ease);
  }

  .logo--fonce .logo__nom {
    color: var(--color-on-ink);
  }

  .logo--fonce .logo__tagline {
    color: var(--color-on-ink-label);
  }

  @media (min-width: 900px) {
    .logo__icone {
      width: 44px;
      height: 44px;
    }

    .logo__nom {
      font-size: 23px;
    }
  }
</style>
