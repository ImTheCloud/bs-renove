---
/**
 * Logo de l'entreprise.
 * Le fichier reçu du client est un PNG à fond blanc opaque (pas de fond
 * transparent) : on ne peut donc l'afficher que sur fond clair. Sur fond
 * ink (bloc contact, pied de page), on garde le texte seul en attendant
 * une version à fond transparent.
 */
import { Image } from 'astro:assets';
import icone from '~/assets/marque/icone-logo.png';
import { entreprise } from '../data/entreprise';
import { t, type Langue } from '../i18n';

interface Props {
  langue: Langue;
  /** Sur fond ink (bloc contact, pied de page), le texte passe en blanc. */
  surFonce?: boolean;
}

const { langue, surFonce = false } = Astro.props;
const textes = t(langue);
---

<span class:list={['logo', { 'logo--fonce': surFonce }]}>
  {!surFonce && <Image src={icone} alt="" width={40} height={40} class="logo__icone" />}
  <span class="logo__texte">
    <span class="logo__nom">
      BS <span class="logo__nom-suite">Renove</span>
    </span>
    <span class="logo__tagline">{textes.entete.tagline}</span>
  </span>
  <span class="sr-only">{entreprise.nomLegal}</span>
</span>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1;
  }

  .logo__icone {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: var(--radius-small);
  }

  .logo__texte {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .logo__nom {
    font-family: var(--font-title);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .logo__nom-suite {
    font-weight: 600;
    color: var(--color-muted);
  }

  .logo__tagline {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-muted);
  }

  .logo--fonce .logo__nom {
    color: var(--color-on-ink);
  }

  .logo--fonce .logo__nom-suite,
  .logo--fonce .logo__tagline {
    color: var(--color-on-ink-label);
  }

  @media (min-width: 900px) {
    .logo__icone {
      width: 40px;
      height: 40px;
    }

    .logo__nom {
      font-size: 28px;
    }

    .logo__tagline {
      font-size: 13px;
    }
  }
</style>
