---
/**
 * Bloc gris à la place d'une photo qu'on n'a pas encore reçue.
 * À remplacer par <Image> d'astro:assets dès que les photos arrivent.
 * Les photos vont dans src/assets/, jamais dans public/ (position GPS).
 */
import Icon from './Icon.astro';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
  /** Ce que la photo montrera, écrit en toutes lettres. */
  legende?: string;
  /** Proportion de l'image, par exemple '4 / 3'. */
  ratio?: string;
  arrondi?: string;
  /** Deux teintes pour distinguer deux blocs côte à côte. */
  ton?: 'clair' | 'moyen' | 'fonce';
  /** Vignette minuscule : on n'affiche que l'icône. */
  compact?: boolean;
  class?: string;
}

const {
  langue,
  legende,
  ratio = '4 / 3',
  arrondi = 'var(--radius-card-img)',
  ton = 'clair',
  compact = false,
  class: classe,
} = Astro.props;

const textes = t(langue);
---

<div
  class:list={['photo', `photo--${ton}`, classe]}
  style={`--ratio: ${ratio}; --arrondi: ${arrondi};`}
  role="img"
  aria-label={legende ?? textes.photos.aVenir}
>
  <Icon nom="carte" taille={compact ? 18 : 26} epaisseur={1.4} />
  {!compact && <span class="photo__titre">{textes.photos.aVenir}</span>}
  {!compact && legende && <span class="photo__legende">{legende}</span>}
</div>

<style>
  .photo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    aspect-ratio: var(--ratio);
    padding: 20px;
    border-radius: var(--arrondi);
    text-align: center;
    color: var(--color-ink);
  }

  .photo--clair {
    background: var(--color-surface);
  }

  .photo--moyen {
    background: var(--color-placeholder);
  }

  .photo--fonce {
    background: var(--color-placeholder-2);
  }

  .photo__titre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .photo__legende {
    max-width: 34ch;
    font-size: var(--size-tiny);
    line-height: 1.4;
  }
</style>
