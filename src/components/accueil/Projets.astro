---
/**
 * Les réalisations de l'accueil : une grille de curseurs avant/après,
 * les mêmes que sur la page Réalisations. On fait glisser le trait soi-même.
 * Téléphone : les 4 premières ; ordinateur : 7 (3 lignes pleines, les horizontales prennent 2 cases).
 */
import Bouton from '../Bouton.astro';
import GrilleAvantApres from '../GrilleAvantApres.astro';
import { pairesAccueil } from '~/data/projets';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const bloc = t(langue).accueil.projets;
const paires = await pairesAccueil();
---

{
  paires.length > 0 && (
    <section class="projets" aria-labelledby="projets-titre">
      <div class="wrap projets__interieur">
        <div class="projets__entete">
          <div>
            <p class="etiquette-section">{bloc.surtitre}</p>
            <h2 id="projets-titre" data-mots>
              {bloc.titreDebut}{' '}<span class="serif">{bloc.titreSerif}</span>
            </h2>
          </div>
          <p class="projets__aide manuscrit" aria-hidden="true">{bloc.aide}</p>
        </div>

        <GrilleAvantApres langue={langue} paires={paires} />

        <div class="projets__actions">
          <Bouton href={chemin('realisations', langue)} variante="principal" iconeApres="fleche-diag">
            {bloc.voirTout}
          </Bouton>
        </div>
      </div>
    </section>
  )
}

<style>
  .projets {
    position: relative;
    margin-top: calc(var(--radius-large) * -1);
    padding-top: calc(var(--section-gap) * 0.7);
    background: var(--color-bg);
    border-radius: var(--radius-large) var(--radius-large) 0 0;
  }

  .projets__interieur {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .projets__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 24px;
  }

  .projets__entete h2 {
    margin-top: 18px;
  }

  .projets__entete h2 .serif {
    color: var(--color-accent);
  }

  .projets__aide {
    margin: 0;
    font-size: 24px;
    color: var(--color-accent);
    transform: rotate(-2deg);
  }

  /* Téléphone : 4 paires suffisent, la suite est sur la page Réalisations. */
  @media (max-width: 699px) {
    .projets__interieur :global(.paire:nth-child(n + 5)) {
      display: none;
    }
  }
</style>
