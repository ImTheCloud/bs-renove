---
/**
 * L'intro de l'accueil, une fois par visite : « B S » se déplie en
 * « Bivol Sergiu » (le nom du gérant, d'où le nom BS Renove), puis le rideau
 * se lève sur le site.
 * - Pas montrée si « réduire les animations » est activé, ni sans JavaScript.
 * - Un clic, une touche ou un défilement la passe tout de suite.
 * - Pendant l'intro, les animations d'arrivée du hero attendent.
 */
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const intro = t(langue).accueil.intro;
---

<script is:inline>
  // Décidé avant le premier affichage, pour que le site n'apparaisse pas avant l'intro.
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    try {
      if (sessionStorage.getItem('intro-bs')) return;
      sessionStorage.setItem('intro-bs', '1');
    } catch (e) {
      /* Stockage indisponible : l'intro se montre quand même. */
    }
    document.documentElement.classList.add('intro-bs');
  })();
</script>

<div class="intro" aria-hidden="true" data-intro>
  <p class="intro__nom">
    <span class="intro__lettre">B</span><span class="intro__suite"><span>ivol</span></span>
    <span class="intro__lettre intro__lettre--s">S</span><span class="intro__suite intro__suite--s"><span>ergiu</span></span>
  </p>
  <p class="intro__note manuscrit">{intro.note}</p>
</div>

<script>
  const html = document.documentElement;
  const intro = document.querySelector<HTMLElement>('[data-intro]');

  if (intro && html.classList.contains('intro-bs')) {
    let fini = false;
    const terminer = (vite = false) => {
      if (fini) return;
      fini = true;
      intro.classList.add(vite ? 'intro--vite' : 'intro--sortie');
      // Le hero démarre pendant que le rideau se lève.
      html.classList.remove('intro-bs');
      window.dispatchEvent(new Event('intro-finie'));
      window.setTimeout(() => intro.remove(), vite ? 350 : 800);
    };

    window.setTimeout(() => terminer(), 2000);
    const passer = () => terminer(true);
    ['pointerdown', 'keydown', 'wheel', 'touchmove'].forEach((evenement) =>
      window.addEventListener(evenement, passer, { once: true, passive: true }),
    );
  }
</script>

<style>
  .intro {
    display: none;
  }

  :global(html.intro-bs) .intro,
  .intro--sortie,
  .intro--vite {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 24px;
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  /* Pendant l'intro, les animations d'arrivée du hero attendent leur tour. */
  :global(html.intro-bs .hero *),
  :global(html.intro-bs .hero *::before),
  :global(html.intro-bs .hero *::after) {
    animation-play-state: paused !important;
  }

  .intro__nom {
    margin: 0;
    display: flex;
    align-items: baseline;
    font-family: var(--font-title);
    font-size: clamp(40px, 17vw, 200px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .intro__lettre {
    display: inline-block;
    animation: lettre 600ms var(--ease-out) backwards;
  }

  .intro__lettre--s {
    margin-left: 0.28em;
    animation-delay: 120ms;
  }

  /* « ivol » et « ergiu » sortent de leur lettre. */
  .intro__suite {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-signal);
    animation: deplier 700ms var(--ease-out) 550ms forwards;
  }

  .intro__suite > span {
    display: inline-block;
    padding-right: 0.06em;
  }

  .intro__suite--s {
    animation-delay: 680ms;
  }

  .intro__note {
    margin: 0;
    max-width: 32ch;
    text-align: center;
    font-size: clamp(22px, 3vw, 32px);
    color: #7cbcff;
    transform: rotate(-2deg);
    animation: fondu 600ms var(--ease-out) 1100ms backwards;
  }

  /* Sortie : le rideau se lève et découvre le site. */
  .intro--sortie {
    animation: lever 700ms var(--ease) forwards;
  }

  .intro--vite {
    animation: effacer 300ms var(--ease) forwards;
  }

  @keyframes lettre {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }

  @keyframes deplier {
    to {
      max-width: 3.4em;
    }
  }

  @keyframes fondu {
    from {
      opacity: 0;
    }
  }

  @keyframes lever {
    to {
      transform: translateY(-100%);
      border-radius: 0 0 var(--radius-large) var(--radius-large);
    }
  }

  @keyframes effacer {
    to {
      opacity: 0;
    }
  }
</style>
