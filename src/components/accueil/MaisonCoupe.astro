---
/**
 * La maison dessinée en coupe, comme sur un plan d'architecte.
 *
 * - Les traits se dessinent à l'arrivée (coupé si « réduire les animations »).
 * - Chaque pièce est un vrai lien vers le service correspondant.
 * - Une petite visite guidée éclaire les pièces une à une, avec une
 *   annotation à la main, jusqu'à ce que la personne touche le dessin.
 *
 * Tout est dessiné ici, en SVG : aucune photo, aucune image générée.
 */
import { services } from '~/data/services';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;
const pieces = hero.pieces;
const lien = (slug: string) => `${chemin('services', langue)}#${slug}`;
/** Le métier est-il proposé sur le site (voir NON_ENREGISTRES dans services.ts) ? */
const propose = (slug: string) => services.some((service) => service.slug === slug);
/** La cave n'est pas un métier : elle mène à son avant/après. */
const lienCave = `${chemin('realisations', langue)}#cave`;
/** La porte d'entrée et sa petite toiture mènent aux avant/après « Petite toiture ». */
const lienAuvent = `${chemin('realisations', langue)}#auvent`;
const lienAllee = `${chemin('realisations', langue)}#allee`;

/** L'ordre de la visite guidée. */
const visite = [
  'toiture',
  'salles-de-bain',
  'electricite',
  'peinture-finitions',
  'cuisines',
  'carrelage',
  'escaliers',
  'terrasses',
  'cave',
  'plomberie',
  'auvent',
  'allee',
  'maconnerie-facades',
  'renovation-complete',
];
---

<figure class="maison" data-maison data-visite={visite.filter((slug) => !['electricite', 'peinture-finitions'].includes(slug) || propose(slug)).join(',')}>
  <svg
    class="maison__svg"
    viewBox="0 0 720 710"
    role="group"
    aria-label={hero.maisonAria}
  >
    <defs>
      <pattern id="hachures" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" class="hachure" />
      </pattern>
      <pattern id="carreaux" width="14" height="14" patternUnits="userSpaceOnUse" x="176" y="336">
        <path d="M14 0H0V14" class="joint" />
      </pattern>
    </defs>

    <!-- ===================== Le dessin (décoratif) ===================== -->
    <g class="dessin" aria-hidden="true">
      <!-- Soleil (jour) / lune et étoiles (nuit) -->
      <g class="astre astre--soleil">
        <g class="t-groupe" style="--d: 1900">
          <circle cx="96" cy="74" r="20" pathLength="1" class="t" />
          <path d="M96 38v-10M96 120v-10M60 74H50M142 74h-10M71 49l-7-7M128 106l-7-7M71 99l-7 7M128 42l-7 7" pathLength="1" class="t t--fin" />
        </g>
      </g>
      <g class="astre astre--lune">
        <path class="lune" d="M104 50a26 26 0 1 0 22 36a21 21 0 1 1-22-36z" />
      </g>
      <g class="etoiles">
        <path style="--e: 0" d="M182 40v12M176 46h12" />
        <path style="--e: 1" d="M252 92v8M248 96h8" />
        <path style="--e: 2" d="M36 150v10M31 155h10" />
        <path style="--e: 3" d="M470 40v12M464 46h12" />
        <path style="--e: 4" d="M600 96v8M596 100h8" />
        <path style="--e: 5" d="M680 40v10M675 45h10" />
        <path style="--e: 6" d="M150 20v8M146 24h8" />
      </g>

      <!-- Sol -->
      <g class="t-groupe" style="--d: 0">
        <path d="M8 560H150M570 560H712" pathLength="1" class="t" />
        <rect x="140" y="560" width="440" height="18" class="mur-plein" />
        <rect x="140" y="560" width="440" height="18" pathLength="1" class="t" />
        <path d="M648 560l3-8M656 560l-3-9M700 560l4-9M708 560l-2-7" pathLength="1" class="t t--fin" />
      </g>

      <!-- Cave (sous-sol) : chauffe-eau, gaines, étagères, sol carrelé -->
      <g class="t-groupe" style="--d: 300">
        <path d="M24 596l6 4M70 628l6 4M36 664l6 4M112 604l6 4M96 684l6 4M606 598l6 4M660 630l6 4M622 672l6 4M690 690l6 4" pathLength="1" class="t t--fin terre" />
        <rect x="150" y="578" width="14" height="92" class="mur-plein" />
        <rect x="556" y="578" width="14" height="92" class="mur-plein" />
        <rect x="150" y="660" width="420" height="10" class="mur-plein" />
        <rect x="150" y="578" width="14" height="92" pathLength="1" class="t" />
        <rect x="556" y="578" width="14" height="92" pathLength="1" class="t" />
        <rect x="150" y="660" width="420" height="10" pathLength="1" class="t" />
        <rect x="164" y="652" width="392" height="8" class="sol-carrele" />
        <path d="M164 652h392M192 652v8M220 652v8M248 652v8M276 652v8M304 652v8M332 652v8M360 652v8M388 652v8M416 652v8M444 652v8M472 652v8M500 652v8M528 652v8" pathLength="1" class="t t--fin" />
        <rect x="186" y="598" width="30" height="54" rx="10" pathLength="1" class="t" />
        <path d="M194 598v-8h14v8M201 590v-8h44" pathLength="1" class="t t--fin" />
        <path d="M236 582h160M236 594h160M252 582v12M268 582v12M284 582v12M300 582v12M316 582v12M332 582v12M348 582v12M364 582v12M380 582v12" pathLength="1" class="t t--fin" />
        <path d="M420 578v10" pathLength="1" class="t t--fin" />
        <circle cx="420" cy="592" r="4" pathLength="1" class="t t--fin" />
        <path d="M468 604h72M468 628h72M474 604v48M534 604v48" pathLength="1" class="t" />
        <rect x="480" y="592" width="18" height="12" pathLength="1" class="t t--fin" />
        <rect x="504" y="616" width="24" height="12" pathLength="1" class="t t--fin" />
      </g>

      <!-- Murs porteurs (hachurés : la maçonnerie coupée) -->
      <g class="t-groupe" style="--d: 150">
        <rect x="150" y="300" width="14" height="260" class="mur-plein" />
        <rect x="556" y="300" width="14" height="260" class="mur-plein" />
        <rect x="150" y="300" width="14" height="260" pathLength="1" class="t" />
        <rect x="556" y="300" width="14" height="260" pathLength="1" class="t" />
      </g>

      <!-- Côté rue (à gauche) : porte d'entrée et sa petite toiture -->
      <g class="t-groupe" style="--d: 1600">
        <rect x="148" y="490" width="18" height="58" class="porte-fond" />
        <rect x="148" y="490" width="18" height="58" pathLength="1" class="t" />
        <rect x="153" y="498" width="8" height="14" class="lumiere" />
        <rect x="153" y="498" width="8" height="14" pathLength="1" class="t t--fin" />
        <circle cx="152" cy="522" r="1.6" class="poignee" />
        <path d="M150 474l-42 10v8l42-4z" class="auvent-toit" />
        <path d="M150 474l-42 10v8l42-4z" pathLength="1" class="t" />
        <path d="M150 500l-22-9" pathLength="1" class="t t--fin" />
      </g>

      <!-- Côté rue : allée pavée -->
      <g class="t-groupe" style="--d: 1700">
        <rect x="0" y="552" width="150" height="8" class="sol-carrele" />
        <path d="M0 552h150M12 552v8M24 552v8M36 552v8M48 552v8M60 552v8M72 552v8M84 552v8M96 552v8M108 552v8M120 552v8M132 552v8M144 552v8" pathLength="1" class="t t--fin" />
      </g>

      <!-- Dalles et cloisons -->
      <g class="t-groupe" style="--d: 450">
        <rect x="164" y="300" width="392" height="10" pathLength="1" class="t" />
        <rect x="164" y="428" width="392" height="10" pathLength="1" class="t" />
        <rect x="360" y="310" width="8" height="52" pathLength="1" class="t" />
        <rect x="378" y="438" width="8" height="54" pathLength="1" class="t" />
      </g>

      <!-- Toiture et charpente -->
      <g class="t-groupe" style="--d: 650">
        <path d="M130 302L360 118L590 302" pathLength="1" class="t t--epais" />
        <path d="M164 300L360 143L556 300" pathLength="1" class="t" />
        <path d="M147 301L360 130.5L573 301" pathLength="1" class="t t--tuiles" />
        <path d="M250 231H470M360 143V231" pathLength="1" class="t t--fin" />
        <rect x="-16" y="-6" width="32" height="12" transform="translate(250 205) rotate(-38.66)" class="lumiere" />
        <rect x="-16" y="-6" width="32" height="12" transform="translate(250 205) rotate(-38.66)" pathLength="1" class="t" />
      </g>

      <!-- Cheminée et fumée -->
      <g class="t-groupe" style="--d: 900">
        <path d="M480 214V176H510V238" pathLength="1" class="t" />
        <path d="M474 176H516M480 188H510M480 200H510M495 176v12M488 188v12M502 188v12" pathLength="1" class="t t--fin" />
        <path d="M494 166c-8-16 12-26 2-42s6-26 0-38" pathLength="1" class="t t--fin fumee" />
      </g>

      <!-- Salle de bain -->
      <g class="t-groupe" style="--d: 1050">
        <rect x="176" y="336" width="100" height="56" class="carreaux" />
        <rect x="176" y="336" width="100" height="56" pathLength="1" class="t t--fin" />
        <rect x="172" y="392" width="110" height="26" rx="10" pathLength="1" class="t" />
        <path d="M186 418v8M268 418v8" pathLength="1" class="t" />
        <path d="M262 318v18M250 336h24" pathLength="1" class="t" />
        <path d="M254 344v8M262 346v10M270 344v8" pathLength="1" class="t t--eau" />
        <path d="M298 384h48q-2 18-24 18t-24-18z" pathLength="1" class="t" />
        <path d="M322 402v26" pathLength="1" class="t" />
        <ellipse cx="322" cy="350" rx="14" ry="20" pathLength="1" class="t" />
      </g>

      <!-- Chambre : lit, lampe, mur fraîchement peint -->
      <g class="t-groupe" style="--d: 1250">
        <rect x="482" y="318" width="70" height="110" class="peint" />
        <rect x="380" y="404" width="90" height="16" rx="3" pathLength="1" class="t" />
        <rect x="386" y="394" width="24" height="10" rx="4" pathLength="1" class="t" />
        <path d="M376 384v44M386 420v8M464 420v8" pathLength="1" class="t" />
        <path d="M408 340h24l26 64h-76z" class="halo" />
        <path d="M420 310v18M408 340l6-12h12l6 12z" pathLength="1" class="t" />
        <rect x="492" y="340" width="28" height="12" rx="4" pathLength="1" class="t" />
        <path d="M520 346h6v18l-10 8v56" pathLength="1" class="t" />
        <rect x="556" y="330" width="14" height="60" class="vitre" />
        <rect x="556" y="330" width="14" height="60" class="lumiere" />
        <path d="M556 330h14v60h-14zM563 330v60" pathLength="1" class="t t--fin" />
      </g>

      <!-- Cuisine -->
      <g class="t-groupe" style="--d: 1400">
        <rect x="172" y="452" width="90" height="30" pathLength="1" class="t" />
        <path d="M217 452v30" pathLength="1" class="t t--fin" />
        <path d="M274 438v28h16v-28M264 478l10-12h16l10 12z" pathLength="1" class="t" />
        <path d="M168 514h166" pathLength="1" class="t t--epais" />
        <rect x="172" y="514" width="158" height="46" pathLength="1" class="t" />
        <path d="M224 514v46M276 514v46M214 526v10M234 526v10M286 526v10" pathLength="1" class="t t--fin" />
        <path d="M272 496v14h20v-14M268 496h28" pathLength="1" class="t" />
        <path d="M278 488c-4-6 4-8 0-14M288 488c-4-6 4-8 0-14" pathLength="1" class="t t--fin fumee" />
        <rect x="338" y="470" width="34" height="90" rx="3" pathLength="1" class="t" />
        <path d="M338 500h34M366 478v12M366 508v14" pathLength="1" class="t t--fin" />
      </g>

      <!-- Séjour : escalier, sol carrelé, tableau électrique -->
      <g class="t-groupe" style="--d: 1550">
        <rect x="386" y="548" width="170" height="12" class="sol-carrele" />
        <path d="M386 548h170M403 548v12M420 548v12M437 548v12M454 548v12M471 548v12M488 548v12M505 548v12M522 548v12M539 548v12" pathLength="1" class="t t--fin" />
        <path d="M548 548v-13.75h-16v-13.75h-16v-13.75h-16v-13.75h-16v-13.75h-16v-13.75h-16v-13.75h-16V438" pathLength="1" class="t" />
        <path d="M436 440l112 108" pathLength="1" class="t t--fin" />
        <rect x="394" y="452" width="24" height="26" rx="2" pathLength="1" class="t" />
        <path d="M409 456l-7 10h6l-4 8" pathLength="1" class="t t--fin" />
        <path d="M406 452v-8h64v8" pathLength="1" class="t t--cable" />
        <path d="M420 310v-6h60v6" pathLength="1" class="t t--cable" />
        <circle cx="470" cy="458" r="6" pathLength="1" class="t" />
      </g>

      <!-- Jardin -->
      <g class="t-groupe" style="--d: 1750">
        <path d="M680 560v-72M680 516l-14-14M680 504l14-14" pathLength="1" class="t" />
        <path d="M680 438c20 0 34 14 34 32s-14 30-34 30-34-12-34-30 14-32 34-32z" pathLength="1" class="t" />
        <rect x="570" y="552" width="70" height="8" class="sol-carrele" />
        <path d="M570 552h70M586 552v8M602 552v8M618 552v8" pathLength="1" class="t t--fin" />
        <path d="M618 552l3-12h14l3 12M628 540c-6-8-3-16 0-20M628 540c5-6 9-9 13-11M628 540c-7-3-11-7-13-11" pathLength="1" class="t" />
      </g>
    </g>

    <!-- ===================== Les pièces (liens) ===================== -->
    <g class="pieces">
      <a href={lien('renovation-complete')} class="piece" data-piece="renovation-complete" aria-label={textes.nav.services}>
        <path class="zone" d="M150 560V302L360 118L570 302V560Z" />
        <text x="16" y="186" class="note">{hero.maisonTout}</text>
        <path class="fleche" d="M60 196c20 30 50 50 96 64" pathLength="1" />
      </a>

      <a href={lien('toiture')} class="piece" data-piece="toiture" aria-label={pieces.toiture}>
        <path class="zone" d="M164 300L360 143L556 300Z" />
        <circle class="point" cx="410" cy="212" r="11" />
        <text x="560" y="98" class="note">{pieces.toiture}</text>
        <path class="fleche" d="M572 110c-30 34-100 76-150 96" pathLength="1" />
      </a>

      <a href={lien('salles-de-bain')} class="piece" data-piece="salles-de-bain" aria-label={pieces['salles-de-bain']}>
        <rect class="zone" x="164" y="310" width="196" height="118" />
        <circle class="point" cx="226" cy="364" r="11" />
        <text x="10" y="262" class="note">{pieces['salles-de-bain']}</text>
        <path class="fleche" d="M90 274c28 46 76 78 122 88" pathLength="1" />
      </a>

      {propose('electricite') && (
        <a href={lien('electricite')} class="piece" data-piece="electricite" aria-label={pieces.electricite}>
          <path class="zone" d="M408 340h24l38 88H370z" />
          <circle class="point" cx="420" cy="364" r="11" />
          <text x="576" y="288" class="note">{pieces.electricite}</text>
          <path class="fleche" d="M590 298c-40 10-106 34-152 60" pathLength="1" />
        </a>
      )}

      {propose('peinture-finitions') && (
        <a href={lien('peinture-finitions')} class="piece" data-piece="peinture-finitions" aria-label={pieces['peinture-finitions']}>
          <rect class="zone" x="482" y="318" width="70" height="110" />
          <circle class="point" cx="510" cy="394" r="11" />
          <text x="588" y="440" class="note">{pieces['peinture-finitions']}</text>
          <path class="fleche" d="M600 420c-20-18-44-24-72-24" pathLength="1" />
        </a>
      )}

      <a href={lien('cuisines')} class="piece" data-piece="cuisines" aria-label={pieces.cuisines}>
        <rect class="zone" x="164" y="438" width="214" height="122" />
        <circle class="point" cx="250" cy="537" r="11" />
        <text x="40" y="610" class="note">{pieces.cuisines}</text>
        <path class="fleche" d="M150 590c30-8 60-24 86-44" pathLength="1" />
      </a>

      <a href={lien('escaliers')} class="piece" data-piece="escaliers" aria-label={pieces.escaliers}>
        <path class="zone" d="M548 548V534.25H532V520.5H516V506.75H500V493H484V479.25H468V465.5H452V451.75H436V438Z" />
        <circle class="point" cx="494" cy="494" r="11" />
        <text x="592" y="512" class="note">{pieces.escaliers}</text>
        <path class="fleche" d="M596 520c-26 6-60 -2-86-18" pathLength="1" />
      </a>

      <a href={lien('terrasses')} class="piece" data-piece="terrasses" aria-label={pieces.terrasses}>
        <rect class="zone" x="570" y="552" width="70" height="8" />
        <circle class="point" cx="596" cy="556" r="11" />
        <text x="718" y="612" text-anchor="end" class="note">{pieces.terrasses}</text>
        <path class="fleche" d="M612 590c-4-6-8-12-12-20" pathLength="1" />
      </a>

      <a href={lienCave} class="piece" data-piece="cave" aria-label={pieces.cave}>
        <rect class="zone" x="228" y="578" width="328" height="74" />
        <circle class="point" cx="330" cy="624" r="11" />
        <text x="250" y="704" class="note">{pieces.cave}</text>
        <path class="fleche" d="M292 682c10-14 22-30 32-44" pathLength="1" />
      </a>

      <a href={lien('plomberie')} class="piece" data-piece="plomberie" aria-label={pieces.plomberie}>
        <rect class="zone" x="170" y="578" width="54" height="74" />
        <circle class="point" cx="201" cy="622" r="11" />
        <text x="30" y="704" class="note">{pieces.plomberie}</text>
        <path class="fleche" d="M120 682c26-12 48-28 68-48" pathLength="1" />
      </a>

      <a href={lien('carrelage')} class="piece" data-piece="carrelage" aria-label={pieces.carrelage}>
        <rect class="zone" x="386" y="548" width="170" height="12" />
        <rect class="zone" x="176" y="336" width="100" height="56" />
        <circle class="point" cx="455" cy="554" r="11" />
        <text x="582" y="612" class="note">{pieces.carrelage}</text>
        <path class="fleche" d="M590 590c-40 0-92-10-120-24" pathLength="1" />
      </a>

      <a href={lien('maconnerie-facades')} class="piece" data-piece="maconnerie-facades" aria-label={pieces['maconnerie-facades']}>
        <rect class="zone" x="150" y="300" width="14" height="260" />
        <rect class="zone" x="556" y="300" width="14" height="260" />
        <path class="zone" d="M480 214V176H510V238Z" />
        <circle class="point" cx="157" cy="362" r="11" />
        <text x="8" y="404" class="note">{pieces['maconnerie-facades']}</text>
        <path class="fleche" d="M66 390c28-4 54-12 80-24" pathLength="1" />
      </a>

      <a href={lienAuvent} class="piece" data-piece="auvent" aria-label={pieces.auvent}>
        <path class="zone" d="M150 474l-42 10v8l42-4z" />
        <rect class="zone" x="148" y="490" width="18" height="58" />
        <circle class="point" cx="118" cy="460" r="11" />
        <text x="6" y="436" class="note">{pieces.auvent}</text>
        <path class="fleche" d="M62 444c14 4 28 8 42 12" pathLength="1" />
      </a>

      <a href={lienAllee} class="piece" data-piece="allee" aria-label={pieces.allee}>
        <rect class="zone" x="0" y="552" width="150" height="8" />
        <circle class="point" cx="126" cy="556" r="11" />
        <text x="20" y="640" class="note">{pieces.allee}</text>
        <path class="fleche" d="M70 618c16-16 30-32 46-50" pathLength="1" />
      </a>
    </g>
  </svg>

  <button
    type="button"
    class="maison__astre"
    aria-pressed="false"
    aria-label={hero.nuit}
    data-astre
    data-label-nuit={hero.nuit}
    data-label-jour={hero.jour}
  ></button>
  <span class="maison__note-astre manuscrit" aria-hidden="true">
    <svg width="30" height="22" viewBox="0 0 30 22" fill="none"><path d="M28 18C20 18 8 14 3 4M3 4l1 8M3 4l8 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <span class="maison__note-nuit">{hero.noteNuit}</span>
    <span class="maison__note-jour">{hero.noteJour}</span>
  </span>

  <figcaption class="maison__aide manuscrit" aria-hidden="true">
    <span class="maison__aide-touch">{hero.maisonAide}</span>
    <span class="maison__aide-souris">{hero.maisonAideSouris}</span>
    <svg width="34" height="24" viewBox="0 0 34 24" fill="none"><path d="M2 20C10 20 24 16 30 4M30 4l-8 2M30 4l1 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  </figcaption>
</figure>

<script>
  /* --- Jour / nuit : le soleil (ou la lune) est un bouton --- */
  document.querySelectorAll<HTMLButtonElement>('[data-astre]').forEach((bouton) => {
    const hero = bouton.closest('.hero') ?? bouton.closest('[data-maison]');
    const entete = document.querySelector<HTMLElement>('[data-entete]');
    const enteteDejaFonce = entete?.classList.contains('entete--sur-fonce') ?? false;
    bouton.addEventListener('click', () => {
      const nuit = bouton.getAttribute('aria-pressed') !== 'true';
      bouton.setAttribute('aria-pressed', String(nuit));
      bouton.setAttribute('aria-label', (nuit ? bouton.dataset.labelJour : bouton.dataset.labelNuit) ?? '');
      hero?.classList.toggle('hero--nuit', nuit);
      // L'en-tête passe en clair tant qu'il est posé sur le haut de page sombre.
      if (entete && !enteteDejaFonce) entete.classList.toggle('entete--sur-fonce', nuit);
      entete?.classList.toggle('entete--nuit', nuit);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-maison]').forEach((maison) => {
    const pieces = new Map<string, Element>();
    maison.querySelectorAll('[data-piece]').forEach((el) => pieces.set(el.getAttribute('data-piece') ?? '', el));
    const ordre = (maison.dataset.visite ?? '').split(',').filter((slug) => pieces.has(slug));
    const calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let courant = -1;
    let minuterie: number | undefined;
    let enPause = false;

    const activer = (slug: string | null) => {
      pieces.forEach((el, cle) => el.classList.toggle('actif', cle === slug));
      maison.classList.toggle('a-une-piece', slug !== null);
      maison.dispatchEvent(new CustomEvent('piece', { detail: slug, bubbles: true }));
    };

    const suivante = () => {
      if (enPause) return;
      courant = (courant + 1) % ordre.length;
      activer(ordre[courant]);
    };

    const demarrer = () => {
      window.clearInterval(minuterie);
      if (calme) return;
      minuterie = window.setInterval(suivante, 2400);
    };

    // La visite commence quand le dessin est terminé.
    maison.classList.add('pret');
    if (!calme) window.setTimeout(() => { suivante(); demarrer(); }, 2600);

    // Survol ou focus : la personne prend la main, la visite s'arrête.
    pieces.forEach((el, slug) => {
      const prendre = () => {
        enPause = true;
        window.clearInterval(minuterie);
        courant = ordre.indexOf(slug);
        activer(slug);
      };
      el.addEventListener('pointerenter', prendre);
      el.addEventListener('focus', prendre);
    });

    maison.addEventListener('pointerleave', () => {
      if (!enPause) return;
      enPause = false;
      demarrer();
    });

    // Les puces de services à côté du dessin pilotent aussi la maison.
    document.querySelectorAll<HTMLElement>('[data-vers-piece]').forEach((puce) => {
      const slug = puce.dataset.versPiece ?? '';
      puce.addEventListener('pointerenter', () => {
        enPause = true;
        window.clearInterval(minuterie);
        activer(slug);
      });
      puce.addEventListener('pointerleave', () => {
        enPause = false;
        demarrer();
      });
    });

    // Hors de l'écran, on arrête de tourner pour rien.
    new IntersectionObserver(([entree]) => {
      if (entree.isIntersecting) {
        if (!enPause && courant >= 0) demarrer();
      } else {
        window.clearInterval(minuterie);
      }
    }).observe(maison);
  });
</script>

