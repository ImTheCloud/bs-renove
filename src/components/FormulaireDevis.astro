---
/**
 * Formulaire de demande de devis.
 *
 * C'est la source de clients du site : il doit marcher dans tous les cas.
 * - Sans JavaScript : envoi classique du navigateur, puis page de remerciement.
 * - Avec JavaScript : envoi en arrière-plan, confirmation affichée sur place.
 *
 * L'envoi passe par Web3Forms (aucun serveur à gérer). La clé vient de .env.
 * Un champ caché sert de piège à robots : un humain ne le remplit jamais.
 */
import Bouton from './Bouton.astro';
import Icon from './Icon.astro';
import { entreprise, lienWhatsApp } from '~/data/entreprise';
import { services } from '~/data/services';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const f = textes.formulaire;

const cle = import.meta.env.WEB3FORMS_KEY;
const cleManquante = !cle?.trim();

// Sans JavaScript, Web3Forms renvoie le visiteur sur cette page.
const pageMerci =
  langue === 'fr' ? '/contact/merci/' : '/nl/contact/bedankt/';
const urlMerci = new URL(pageMerci, Astro.site).href;

const sujet =
  langue === 'fr'
    ? 'Nouvelle demande de devis · site BS Renove'
    : 'Nieuwe offerteaanvraag · website BS Renove';
---

{
  cleManquante ? (
    <div class="alerte" role="status">
      <span class="alerte__titre">
        [{textes.aConfirmer}] {f.cleManquanteTitre}
      </span>
      <p>{f.cleManquanteTexte}</p>
      <div class="alerte__actions">
        <Bouton href={`tel:${entreprise.telephoneLien}`} variante="principal" icone="telephone">
          {entreprise.telephoneAffiche}
        </Bouton>
        <Bouton
          href={lienWhatsApp(textes.whatsappMessage)}
          variante="secondaire"
          icone="whatsapp"
          target="_blank"
          rel="noopener"
        >
          {textes.actions.whatsappCourt}
        </Bouton>
      </div>
    </div>
  ) : (
    <div class="devis" data-devis>
      <form
        class="devis__form"
        data-form
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={cle} />
        <input type="hidden" name="subject" value={sujet} />
        <input type="hidden" name="from_name" value="BS Renove" />
        <input type="hidden" name="redirect" value={urlMerci} />

        {/* Piège à robots : caché à l'œil et au lecteur d'écran. */}
        <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="champ">
          <label for="devis-nom">
            {f.nom} <span class="champ__obligatoire">({f.obligatoire})</span>
          </label>
          <input type="text" id="devis-nom" name="nom" required autocomplete="name" aria-describedby="devis-nom-aide" />
          <span id="devis-nom-aide" class="champ__aide">{f.nomAide}</span>
        </div>

        <div class="champ__paire">
          <div class="champ">
            <label for="devis-tel">
              {f.telephone} <span class="champ__obligatoire">({f.obligatoire})</span>
            </label>
            <input type="tel" id="devis-tel" name="telephone" required autocomplete="tel" inputmode="tel" aria-describedby="devis-tel-aide" />
            <span id="devis-tel-aide" class="champ__aide">{f.telephoneAide}</span>
          </div>

          <div class="champ">
            <label for="devis-email">
              {f.email} <span class="champ__obligatoire">({f.obligatoire})</span>
            </label>
            <input type="email" id="devis-email" name="email" required autocomplete="email" inputmode="email" />
          </div>
        </div>

        <div class="champ__paire">
          <div class="champ">
            <label for="devis-commune">
              {f.commune} <span class="champ__obligatoire">({f.obligatoire})</span>
            </label>
            <input type="text" id="devis-commune" name="commune" required autocomplete="address-level2" aria-describedby="devis-commune-aide" />
            <span id="devis-commune-aide" class="champ__aide">{f.communeAide}</span>
          </div>

          <div class="champ">
            <label for="devis-travaux">
              {f.typeTravaux} <span class="champ__obligatoire">({f.obligatoire})</span>
            </label>
            <select id="devis-travaux" name="type_de_travaux" required>
              <option value="">{f.choisir}</option>
              {services.map((service) => (
                <option value={service.nom[langue]}>{service.nom[langue]}</option>
              ))}
              <option value={f.autre}>{f.autre}</option>
            </select>
          </div>
        </div>

        <div class="champ">
          <label for="devis-message">
            {f.message} <span class="champ__obligatoire">({f.obligatoire})</span>
          </label>
          <textarea id="devis-message" name="message" rows="5" required aria-describedby="devis-message-aide" />
          <span id="devis-message-aide" class="champ__aide">{f.messageAide}</span>
        </div>

        <div class="consentement">
          <input type="checkbox" id="devis-consentement" name="consentement" required value="oui" />
          <label for="devis-consentement">
            {f.consentement}{' '}
            <a href={chemin('viePrivee', langue)}>{f.consentementLien}</a>
          </label>
        </div>

        <div class="devis__envoi">
          <Bouton
            type="submit"
            variante="principal"
            iconeApres="fleche"
            large
            class="devis__bouton"
            data-en-cours={f.envoiEnCours}
          >
            {f.envoyer}
          </Bouton>
        </div>

        <p class="sr-only" data-etat aria-live="polite" />

        <p class="devis__erreur" data-erreur hidden role="alert" tabindex="-1">
          <strong>{f.erreurTitre}</strong>{' '}
          {f.erreurTexte} <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephoneAffiche}</a>.
        </p>
      </form>

      {/* Affiché à la place du formulaire une fois l'envoi réussi. */}
      <div class="merci" data-merci hidden tabindex="-1">
        <span class="merci__coche">
          <Icon nom="check" taille={26} epaisseur={2.2} />
        </span>
        <h3>{f.merciTitre}</h3>
        <p>{f.merciTexte}</p>
        <Bouton
          href={lienWhatsApp(textes.whatsappMessage)}
          variante="principal"
          icone="whatsapp"
          large
          target="_blank"
          rel="noopener"
        >
          {f.merciWhatsApp}
        </Bouton>
      </div>
    </div>
  )
}

<script>
  const bloc = document.querySelector<HTMLElement>('[data-devis]');
  const form = bloc?.querySelector<HTMLFormElement>('[data-form]');
  const merci = bloc?.querySelector<HTMLElement>('[data-merci]');
  const erreur = bloc?.querySelector<HTMLElement>('[data-erreur]');
  const etat = bloc?.querySelector<HTMLElement>('[data-etat]');

  if (form && merci && erreur) {
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const libelleBouton = bouton?.querySelector('span');
    const texteInitial = libelleBouton?.textContent ?? '';

    // Le JavaScript a chargé : on envoie en arrière-plan plutôt que de quitter la page.
    form.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      erreur.hidden = true;

      if (bouton) bouton.disabled = true;
      if (libelleBouton) libelleBouton.textContent = bouton?.dataset.enCours ?? texteInitial;
      if (etat) etat.textContent = bouton?.dataset.enCours ?? '';

      // « redirect » ne sert qu'à l'envoi sans JavaScript : ici il ferait
      // suivre une redirection au fetch, qui échouerait alors que la
      // demande est bien partie. On l'enlève de cet envoi-ci.
      const donnees = new FormData(form);
      donnees.delete('redirect');

      try {
        const reponse = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: donnees,
          // Sur une connexion qui se fige, on abandonne plutôt que de
          // laisser le bouton bloqué sur « Envoi… » pendant des minutes.
          signal: AbortSignal.timeout(15000),
        });

        if (!reponse.ok) throw new Error(String(reponse.status));

        if (etat) etat.textContent = '';
        form.hidden = true;
        merci.hidden = false;
        merci.focus(); // on emmène le lecteur d'écran sur la confirmation
      } catch {
        if (etat) etat.textContent = '';
        erreur.hidden = false;
        erreur.focus();
        if (bouton) bouton.disabled = false;
        if (libelleBouton) libelleBouton.textContent = texteInitial;
      }
    });
  }
</script>

<style>
  .devis__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .champ__paire {
    display: grid;
    gap: 20px;
  }

  .champ label,
  .consentement label {
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-ink);
  }

  .champ__obligatoire {
    font-weight: 500;
    color: var(--color-muted);
  }

  .champ__aide {
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  .champ input,
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: var(--tap-min);
    padding: 13px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-field);
    border-radius: var(--radius-small);
    font-family: var(--font-text);
    font-size: var(--size-body);
    color: var(--color-ink);
  }

  .champ textarea {
    min-height: 130px;
    resize: vertical;
  }

  .champ input:focus,
  .champ select:focus,
  .champ textarea:focus {
    border-color: var(--color-accent);
  }

  /* Le rouge n'apparaît qu'après une tentative d'envoi, jamais en cours de saisie. */
  .champ input:user-invalid,
  .champ select:user-invalid,
  .champ textarea:user-invalid {
    border-color: var(--color-erreur);
  }

  .consentement {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background: var(--color-surface);
    border-radius: var(--radius-small);
  }

  .consentement input {
    width: 22px;
    height: 22px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--color-accent);
  }

  .consentement label {
    font-weight: 500;
    color: var(--color-text);
  }

  .devis__envoi :global(.bouton) {
    width: 100%;
  }

  .devis__erreur {
    outline: none;
    padding: 14px 16px;
    background: var(--color-surface);
    border-radius: var(--radius-small);
    font-size: var(--size-small);
    color: var(--color-ink);
  }

  .merci {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 32px 24px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .merci:focus {
    outline: none;
  }

  .merci__coche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background: var(--color-bg);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
  }

  .merci p {
    color: var(--color-text);
  }

  .alerte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px 24px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .alerte__titre {
    font-family: var(--font-title);
    font-size: var(--size-h3);
    font-weight: 700;
    letter-spacing: var(--tracking-h3);
    color: var(--color-ink);
  }

  .alerte p {
    color: var(--color-text);
  }

  .alerte__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (min-width: 620px) {
    .champ__paire {
      grid-template-columns: repeat(2, 1fr);
    }

    .devis__envoi :global(.bouton) {
      width: auto;
    }
  }
</style>
