---
/**
 * Affiche une page légale (mentions légales ou vie privée).
 * Les faits sur l'entreprise viennent de src/data/entreprise.ts :
 * ils ne sont jamais recopiés à la main dans les textes.
 */
import { adresseUneLigne, entreprise } from '~/data/entreprise';
import type { BlocLegal } from '~/data/textes-legaux';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
  titre: string;
  blocs: BlocLegal[];
}

const { langue, titre, blocs } = Astro.props;
const textes = t(langue);
const L = textes.legal;

const email = entreprise.email ?? entreprise.telephoneAffiche;

// Seuls les blocs qui correspondent à la configuration réelle du site sont affichés.
const web3forms = Boolean((import.meta.env.WEB3FORMS_KEY ?? '').trim());
const visibles = blocs.filter(
  (bloc) =>
    !bloc.si ||
    (bloc.si === 'web3forms' && web3forms) ||
    (bloc.si === 'email' && !web3forms) ||
    (bloc.si === 'hebergeur' && entreprise.hebergeur),
);

/** Remplace les marques {email} et {telephone} dans les textes. */
const remplacer = (texte: string) =>
  texte
    .replaceAll('{email}', email)
    .replaceAll('{telephone}', entreprise.telephoneAffiche)
    .replaceAll('{hebergeur}', entreprise.hebergeur ?? '');

const identite: { label: string; valeur: string }[] = [
  { label: L.nomLegal, valeur: entreprise.nomLegal },
  { label: L.formeJuridique, valeur: L.formeJuridiqueValeur },
  { label: L.gerant, valeur: entreprise.gerant },
  { label: L.siege, valeur: adresseUneLigne },
  { label: L.entreprise, valeur: entreprise.tva },
  { label: L.rpm, valeur: entreprise.rpm[langue] },
  { label: L.telephone, valeur: entreprise.telephoneAffiche },
  { label: L.email, valeur: email },
];
---

<article class="wrap legale">
  <header class="legale__entete">
    <h1>{titre}</h1>
  </header>

  <section class="legale__bloc">
    <h2>{L.identite}</h2>
    <dl class="legale__identite">
      {
        identite.map((ligne) => (
          <div>
            <dt>{ligne.label}</dt>
            <dd class:list={{ 'legale__manquant': ligne.valeur.startsWith('[') }}>{ligne.valeur}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    visibles.map((bloc) => (
      <section class="legale__bloc">
        <h2>{bloc.titre[langue]}</h2>
        {bloc.paragraphes?.[langue].map((p) => <p>{remplacer(p)}</p>)}
        {bloc.liste && (
          <ul>
            {bloc.liste[langue].map((element) => (
              <li>{element}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <p class="legale__maj">{L.majLe}{t(langue).deuxPoints}{L.majValeur}</p>
</article>

<style>
  .legale {
    max-width: 820px;
    padding-block: calc(var(--header-h) + 48px) 0;
  }

  .legale__entete {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .legale__bloc {
    margin-bottom: 36px;
  }

  .legale__bloc h2 {
    margin-bottom: 14px;
    font-size: var(--size-h3);
    letter-spacing: var(--tracking-h3);
  }

  .legale__bloc p {
    margin-bottom: 12px;
    color: var(--color-text);
  }

  .legale__bloc ul {
    margin: 4px 0 0;
    padding-left: 22px;
    color: var(--color-text);
  }

  .legale__bloc li {
    margin-bottom: 6px;
  }

  .legale__identite {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .legale__identite div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .legale__identite dt {
    font-size: var(--size-tiny);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .legale__identite dd {
    margin: 0;
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-ink);
  }

  .legale__manquant {
    color: var(--color-accent);
  }

  .legale__maj {
    padding-top: 28px;
    border-top: 1px solid var(--color-border-light);
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  @media (min-width: 620px) {
    .legale__identite {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px 32px;
    }
  }
</style>
