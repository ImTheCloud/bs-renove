---
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { entreprise, lienWhatsApp } from '~/data/entreprise';
import { projetMisEnAvant } from '~/data/projets';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const hero = textes.accueil.hero;

// L'étiquette de la photo vient du projet mis en avant, pas d'un texte en dur.
const projet = await projetMisEnAvant();
const etiquette = projet
  ? `${projet.data.titre[langue]} · ${projet.data.commune[langue]}`
  : undefined;
---

<section class="wrap hero">
  <div class="hero__texte">
    <span class="hero__zone">
      <Icon nom="pin" taille={16} />
      {hero.zone}
    </span>

    <h1 class="hero__titre">
      {hero.titreDebut}{' '}<span class="hero__titre-accent">{hero.titreFin}</span>
    </h1>

    <p class="hero__intro">{hero.texte}</p>

    <div class="hero__actions">
      <Bouton href={chemin('contact', langue)} variante="principal" iconeApres="fleche" large>
        {textes.actions.devis}
      </Bouton>
      <Bouton
        href={lienWhatsApp(textes.whatsappMessage)}
        variante="secondaire"
        icone="whatsapp"
        large
        target="_blank"
        rel="noopener"
      >
        {textes.actions.whatsapp}
      </Bouton>
    </div>

    <a href={`tel:${entreprise.telephoneLien}`} class="hero__appel">
      <Icon nom="telephone" taille={18} />
      <span>{textes.actions.appelerLong}</span>
      <strong>{entreprise.telephoneAffiche}</strong>
    </a>

    <ul class="hero__atouts">
      {
        hero.atouts.map((atout) => (
          <li class="hero__atout">
            <span class="hero__coche">
              <Icon nom="check" taille={15} epaisseur={2.2} />
            </span>
            {atout}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hero__visuel">
    <PhotoProjet
      image={projet?.data.couverture}
      alt={projet ? projet.data.couvertureAlt[langue] : textes.photos.principale}
      langue={langue}
      ratio="4 / 3"
      arrondi="var(--radius-photo)"
      prioritaire
    />

    {etiquette && <span class="hero__etiquette">{etiquette}</span>}

    <div class="hero__badge">
      <span class="hero__badge-coche">
        <Icon nom="check" taille={22} epaisseur={2} />
      </span>
      <span class="hero__badge-texte">
        <span class="hero__badge-nombre">{entreprise.anneesExperience} {hero.badgeUnite}</span>
        <span class="hero__badge-detail">{hero.badgeTexte}</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 40px;
    padding-block: 24px 40px;
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .hero__zone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-muted);
  }

  .hero__titre {
    margin: 0;
  }

  .hero__titre-accent {
    color: var(--color-accent);
  }

  .hero__intro {
    max-width: 52ch;
    font-size: var(--size-body);
    color: var(--color-text);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__appel {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--size-small);
    color: var(--color-muted);
    text-decoration: none;
  }

  .hero__appel strong {
    color: var(--color-ink);
  }

  .hero__appel:hover strong {
    text-decoration: underline;
  }

  .hero__atouts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__atout {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px 9px 10px;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__coche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--color-bg);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
  }

  /* --- Le visuel --- */
  .hero__visuel {
    position: relative;
  }

  .hero__etiquette {
    position: absolute;
    top: 18px;
    left: 18px;
    padding: 8px 18px;
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-pill);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__badge {
    position: absolute;
    right: 18px;
    bottom: -20px;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: calc(100% - 36px);
    padding: 16px 24px 16px 16px;
    background: var(--color-bg);
    border-radius: var(--radius-small);
    box-shadow: var(--shadow-float);
  }

  .hero__badge-coche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
  }

  .hero__badge-texte {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero__badge-nombre {
    font-family: var(--font-title);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .hero__badge-detail {
    font-size: var(--size-tiny);
    color: var(--color-muted);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 56px;
      padding-block: 32px 48px;
    }

    .hero__badge {
      bottom: -26px;
    }

    .hero__badge-nombre {
      font-size: 22px;
    }
  }

  /*
    Le seul mouvement du site : l'arrivée du hero.
    Coupé si la personne a demandé moins d'animations.
  */
  @media (prefers-reduced-motion: no-preference) {
    .hero__texte > *,
    .hero__visuel {
      animation: arrivee 620ms var(--ease) backwards;
    }

    .hero__texte > *:nth-child(1) { animation-delay: 60ms; }
    .hero__texte > *:nth-child(2) { animation-delay: 110ms; }
    .hero__texte > *:nth-child(3) { animation-delay: 160ms; }
    .hero__texte > *:nth-child(4) { animation-delay: 210ms; }
    .hero__texte > *:nth-child(5) { animation-delay: 250ms; }
    .hero__texte > *:nth-child(6) { animation-delay: 290ms; }
    .hero__visuel { animation-delay: 140ms; }

    @keyframes arrivee {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
