---
/**
 * La page Réalisations : un mur d'avant/après, groupés par type de pièce,
 * peu importe le chantier d'origine. L'avant/après est l'élément le plus
 * apprécié du site : ici il occupe toute la place, en grand.
 */
import CurseurAvantApres from '../CurseurAvantApres.astro';
import EntetePage from '../EntetePage.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { categories, nomCategorie } from '~/data/categories';
import { toutesLesPaires } from '~/data/projets';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.realisations;

const paires = await toutesLesPaires();
const categoriesPresentes = categories.filter((c) => paires.some((p) => p.categorie === c.slug));
---

<EntetePage surtitre={bloc.surtitre} titre={bloc.titre} serifMots={3} intro={bloc.intro} />

<section class="wrap liste">
  {
    paires.length === 0 ? (
      <p class="liste__vide">{bloc.aucun}</p>
    ) : (
      <>
        {categoriesPresentes.length > 1 && (
          <div class="liste__filtres" role="group" aria-label={bloc.filtrerAria}>
            <button type="button" class="filtre filtre--actif" data-filtre="toutes" aria-pressed="true">
              {bloc.toutes}
            </button>
            {categoriesPresentes.map((c) => (
              <button type="button" class="filtre" data-filtre={c.slug} aria-pressed="false">
                {c.nom[langue]}
              </button>
            ))}
          </div>
        )}

        <div class="liste__paires" data-galerie-paires>
          {paires.map((paire, index) => (
            <figure class="paire" data-categorie={paire.categorie}>
              <CurseurAvantApres
                langue={langue}
                id={`curseur-${paire.projetId}-${index}`}
                ratio="3 / 4"
                precision={paire.legende[langue]}
              >
                <PhotoProjet
                  slot="avant"
                  image={paire.avant}
                  alt={textes.photos.avant}
                  langue={langue}
                  ratio="3 / 4"
                  ton="moyen"
                  prioritaire={index === 0}
                />
                <PhotoProjet
                  slot="apres"
                  image={paire.apres}
                  alt={textes.photos.apres}
                  langue={langue}
                  ratio="3 / 4"
                  ton="fonce"
                  prioritaire={index === 0}
                />
              </CurseurAvantApres>
              <figcaption class="paire__legende">
                <span class="paire__categorie">{nomCategorie(paire.categorie, langue)}</span>
                <a href={`${chemin('realisations', langue)}${paire.projetId}/`} class="paire__lien">
                  {bloc.voirLeProjet}
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    )
  }
</section>

<script>
  // Filtre les avant/après par catégorie, sans recharger la page.
  document.querySelectorAll<HTMLElement>('.liste__filtres').forEach((groupe) => {
    const boutons = Array.from(groupe.querySelectorAll<HTMLButtonElement>('.filtre'));
    const galerie = groupe.nextElementSibling;
    const paires = Array.from(galerie?.querySelectorAll<HTMLElement>('.paire') ?? []);

    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        boutons.forEach((b) => {
          const actif = b === bouton;
          b.classList.toggle('filtre--actif', actif);
          b.setAttribute('aria-pressed', String(actif));
        });
        const cible = bouton.dataset.filtre;
        paires.forEach((paire) => {
          paire.hidden = cible !== 'toutes' && paire.dataset.categorie !== cible;
        });
      });
    });
  });
</script>

<style>
  .liste {
    padding-bottom: 0;
  }

  .liste__vide {
    padding: 40px 0;
    color: var(--color-muted);
  }

  .liste__filtres {
    position: sticky;
    top: calc(var(--header-h) + 4px);
    z-index: 5;
    display: flex;
    gap: 8px;
    margin: 0 calc(var(--gutter) * -1) 32px;
    padding: 10px var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    background: linear-gradient(var(--color-bg) 70%, transparent);
  }

  .liste__filtres::-webkit-scrollbar {
    display: none;
  }

  .filtre {
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .filtre:hover {
    border-color: var(--color-ink);
  }

  .filtre--actif,
  .filtre--actif:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-ink);
  }

  .liste__paires {
    display: grid;
    gap: 40px 20px;
  }

  .paire {
    margin: 0;
  }

  .paire__legende {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 14px;
    padding-top: 14px;
  }

  .paire__categorie {
    padding: 5px 12px;
    background: var(--color-signal);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .paire__lien {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--size-small);
    font-weight: 650;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 5px;
  }

  .paire__lien:hover {
    text-decoration-color: var(--color-ink);
  }

  @media (min-width: 700px) {
    .liste__paires {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .liste__paires {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 56px 24px;
    }
  }
</style>
