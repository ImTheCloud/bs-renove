---
import CarteProjet from '../CarteProjet.astro';
import { listerProjets } from '~/data/projets';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.realisations;
const projets = await listerProjets();
---

<section class="wrap liste">
  <header class="liste__entete">
    <span class="surtitre">{bloc.surtitre}</span>
    <h1>{bloc.titre}</h1>
    <p class="liste__intro">{bloc.intro}</p>
  </header>

  {
    projets.length === 0 ? (
      <p class="liste__vide">{bloc.aucun}</p>
    ) : (
      <ul class="liste__grille">
        {projets.map((projet) => (
          <li>
            <CarteProjet projet={projet} langue={langue} niveauTitre={2} />
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .liste {
    padding-block: 40px 0;
  }

  .liste__entete {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 620px;
    margin-bottom: 44px;
  }

  .surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .liste__intro {
    color: var(--color-text);
  }

  .liste__vide {
    padding: 40px 0;
    color: var(--color-muted);
  }

  .liste__grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .liste__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .liste__grille {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
</style>
