---
/**
 * La page Réalisations : un mur d'avant/après, groupés par type de pièce,
 * peu importe le chantier d'origine. L'avant/après est l'élément le plus
 * apprécié du site : ici il occupe toute la place, en grand.
 */
import CurseurAvantApres from '../CurseurAvantApres.astro';
import EntetePage from '../EntetePage.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { categories, nomCategorie } from '~/data/categories';
import { toutesLesPaires } from '~/data/projets';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.realisations;

const paires = await toutesLesPaires();
const categoriesPresentes = categories.filter((c) => paires.some((p) => p.categorie === c.slug));
---

<EntetePage surtitre={bloc.surtitre} titre={bloc.titre} serifMots={3} intro={bloc.intro} />

<section class="wrap liste">
  {
    paires.length === 0 ? (
      <p class="liste__vide">{bloc.aucun}</p>
    ) : (
      <>
        {categoriesPresentes.length > 1 && (
          <div class="liste__filtres" role="group" aria-label={bloc.filtrerAria}>
            <button type="button" class="filtre filtre--actif" data-filtre="toutes" aria-pressed="true">
              {bloc.toutes}
            </button>
            {categoriesPresentes.map((c) => (
              <button type="button" class="filtre" data-filtre={c.slug} aria-pressed="false">
                {c.nom[langue]}
              </button>
            ))}
          </div>
        )}

        <div class="liste__paires" data-galerie-paires>
          {paires.map((paire, index) => (
            <figure class:list={['paire', { 'paire--paysage': paire.paysage }]} data-categorie={paire.categorie}>
              <CurseurAvantApres
                langue={langue}
                id={`curseur-${paire.id}`}
                depart={paire.depart}
                ratio={paire.ratio}
                precision={paire.legende[langue]}
              >
                <PhotoProjet
                  slot="avant"
                  image={paire.avant}
                  alt={textes.photos.avant}
                  langue={langue}
                  ratio={paire.ratio}
                  ton="moyen"
                  prioritaire={index === 0}
                />
                <PhotoProjet
                  slot="apres"
                  image={paire.apres}
                  alt={textes.photos.apres}
                  langue={langue}
                  ratio={paire.ratio}
                  ton="fonce"
                  prioritaire={index === 0}
                />
              </CurseurAvantApres>
              <figcaption class="paire__legende">
                <span class="paire__categorie">{nomCategorie(paire.categorie, langue)}</span>
                {paire.commune && <span class="paire__commune">{paire.commune[langue]}</span>}
                <span class="paire__texte">{paire.legende[langue]}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    )
  }
</section>

<script>
  // Filtre les avant/après par catégorie, sans recharger la page.
  document.querySelectorAll<HTMLElement>('.liste__filtres').forEach((groupe) => {
    const boutons = Array.from(groupe.querySelectorAll<HTMLButtonElement>('.filtre'));
    const galerie = groupe.nextElementSibling;
    const paires = Array.from(galerie?.querySelectorAll<HTMLElement>('.paire') ?? []);

    const filtrer = (bouton: HTMLButtonElement) => {
      boutons.forEach((b) => {
        const actif = b === bouton;
        b.classList.toggle('filtre--actif', actif);
        b.setAttribute('aria-pressed', String(actif));
      });
      const cible = bouton.dataset.filtre;
      paires.forEach((paire) => {
        paire.hidden = cible !== 'toutes' && paire.dataset.categorie !== cible;
      });
      return cible;
    };

    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        const cible = filtrer(bouton);
        // L'adresse garde le filtre : on peut partager « /realisations/#cuisine ».
        history.replaceState(null, '', cible === 'toutes' ? location.pathname : `#${cible}`);
      });
    });

    // Arrivée avec un filtre dans l'adresse (ex. depuis la page Services).
    const depuisAdresse = boutons.find((b) => `#${b.dataset.filtre}` === location.hash);
    if (depuisAdresse) filtrer(depuisAdresse);
  });
</script>

<style>
  .liste {
    padding-bottom: 0;
  }

  .liste__vide {
    padding: 40px 0;
    color: var(--color-muted);
  }

  .liste__filtres {
    display: flex;
    gap: 8px;
    margin: 0 calc(var(--gutter) * -1) 32px;
    padding: 4px var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  @media (min-width: 900px) {
    .liste__filtres {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  .liste__filtres::-webkit-scrollbar {
    display: none;
  }

  .filtre {
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      color var(--speed) var(--ease);
  }

  .filtre:hover {
    border-color: var(--color-ink);
  }

  .filtre--actif,
  .filtre--actif:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-on-ink);
  }

  .liste__paires {
    display: grid;
    gap: 40px 20px;
    /* La grille sert de repère (cqw) pour caler la hauteur des paires horizontales. */
    container-type: inline-size;
  }

  .paire {
    margin: 0;
  }

  @media (min-width: 700px) {
    .liste__paires {
      grid-auto-flow: dense;
    }

    .paire--paysage {
      grid-column: span 2;
    }

    /* Plus large, mais aussi haute qu'une paire verticale (2 colonnes, écart 20px). */
    .paire--paysage :global(.curseur) {
      aspect-ratio: auto;
      height: calc((100cqw - 20px) / 2 * 4 / 3);
    }
  }

  @media (min-width: 1100px) {
    /* Même principe sur 3 colonnes (écart 24px). */
    .paire--paysage :global(.curseur) {
      height: calc((100cqw - 48px) / 3 * 4 / 3);
    }
  }

  .paire__legende {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding-top: 14px;
  }

  .paire__categorie {
    padding: 5px 12px;
    background: var(--color-signal);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .paire__commune {
    font-family: var(--font-title);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .paire__texte {
    flex-basis: 100%;
    font-size: var(--size-small);
    color: var(--color-muted);
  }

  @media (min-width: 700px) {
    .liste__paires {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .liste__paires {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 56px 24px;
    }
  }
</style>
