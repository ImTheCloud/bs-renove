---
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import PhotoAVenir from '../PhotoAVenir.astro';
import { services } from '~/data/services';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.accueil.services;
---

<section id="services" class="wrap services">
  <div class="services__entete">
    <div class="services__titres">
      <span class="surtitre">{bloc.surtitre}</span>
      <h2>{bloc.titre}</h2>
    </div>
    <Bouton href={chemin('services', langue)} variante="secondaire" iconeApres="fleche">
      {bloc.bouton}
    </Bouton>
  </div>

  <ul class="services__grille">
    {
      services.map((service) => (
        <li>
          <a href={`${chemin('services', langue)}#${service.slug}`} class="carte">
            <PhotoAVenir langue={langue} legende={service.nom[langue]} ratio="4 / 3" />
            <div class="carte__texte">
              <div class="carte__ligne">
                <h3>{service.nom[langue]}</h3>
                <span class="carte__fleche">
                  <Icon nom="fleche" taille={18} />
                </span>
              </div>
              <p>{service.phrase[langue]}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    padding-block: var(--section-gap) 0;
  }

  .services__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }

  .services__titres {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 620px;
  }

  .surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .services__grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .carte {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition:
      border-color var(--speed) var(--ease),
      background-color var(--speed) var(--ease);
  }

  .carte:hover {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .carte__texte {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 8px 10px;
  }

  .carte__ligne {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .carte__fleche {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform var(--speed) var(--ease);
  }

  .carte:hover .carte__fleche {
    transform: translateX(3px);
  }

  .carte p {
    font-size: var(--size-small);
    color: var(--color-text);
  }

  @media (min-width: 600px) {
    .services__grille {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .services__grille {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
</style>
