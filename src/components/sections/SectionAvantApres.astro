---
/**
 * L'avant/après de l'accueil : l'élément le plus marquant du site, en
 * grand, sans cadre autour — la photo occupe toute la place plutôt que
 * d'être une carte parmi d'autres.
 */
import Bouton from '../Bouton.astro';
import CurseurAvantApres from '../CurseurAvantApres.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { nomService, projetMisEnAvant } from '~/data/projets';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.accueil.avantApres;

// Le projet mis en avant vient de src/content/projets/, plus d'un texte en dur.
const projet = await projetMisEnAvant();
const service = projet ? nomService(projet.data.service, langue) : undefined;
const paire = projet?.data.avantApres[0];
const lienProjet = projet ? `${chemin('realisations', langue)}${projet.id}/` : chemin('realisations', langue);
---

{
  projet && paire && (
    <section id="realisations" class="wrap avant-apres">
      <div class="avant-apres__curseur">
        <CurseurAvantApres langue={langue} id="curseur-accueil" ratio="16 / 9" precision={paire.legende[langue]}>
          <PhotoProjet
            slot="avant"
            image={paire.avant}
            alt={textes.photos.avant}
            langue={langue}
            ratio="16 / 9"
            ton="moyen"
            prioritaire
          />
          <PhotoProjet
            slot="apres"
            image={paire.apres}
            alt={textes.photos.apres}
            langue={langue}
            ratio="16 / 9"
            ton="fonce"
            prioritaire
          />
        </CurseurAvantApres>
      </div>

      <div class="avant-apres__infos">
        <div class="avant-apres__projet">
          <span class="surtitre">{bloc.surtitre}</span>
          <h2 class="avant-apres__titre">
            <a href={lienProjet}>{projet.data.titre[langue]}</a>
          </h2>
          {(service || paire) && (
            <ul class="avant-apres__pastilles">
              {service && <li>{service}</li>}
              <li>{paire.legende[langue]}</li>
            </ul>
          )}
        </div>

        <Bouton href={chemin('realisations', langue)} variante="secondaire" iconeApres="fleche">
          {bloc.voirTout}
        </Bouton>
      </div>
    </section>
  )
}

<style>
  .avant-apres {
    padding-block: var(--section-gap) 0;
  }

  .avant-apres__infos {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding-top: 28px;
  }

  .avant-apres__projet {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .avant-apres__titre {
    font-size: var(--size-h2);
    letter-spacing: var(--tracking-h2);
  }

  .avant-apres__titre a {
    color: inherit;
    text-decoration: none;
  }

  .avant-apres__titre a:hover {
    text-decoration: underline;
  }

  .avant-apres__pastilles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .avant-apres__pastilles li {
    padding: 8px 16px;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
