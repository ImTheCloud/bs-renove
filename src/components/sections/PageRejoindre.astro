---
/** La page « Rejoindre l'équipe » : un en-tête et un bouton qui ouvre un email de candidature. */
import Bouton from '../Bouton.astro';
import EntetePage from '../EntetePage.astro';
import { lienEmail } from '~/data/entreprise';
import { t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const bloc = t(langue).rejoindreEquipe;
---

<EntetePage surtitre={bloc.surtitre} titre={bloc.titre} serifMots={3} intro={bloc.intro} />

<section class="wrap rejoindre">
  <div class="rejoindre__carte">
    <h2 class="rejoindre__titre">{bloc.candidatureTitre}</h2>
    <p>{bloc.candidatureTexte}</p>
    <Bouton href={lienEmail(bloc.sujetEmail, bloc.corpsEmail)} variante="principal" icone="email" large>
      {bloc.bouton}
    </Bouton>
  </div>
</section>

<style>
  .rejoindre__carte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 520px;
    padding: 32px 28px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .rejoindre__titre {
    font-size: var(--size-h3);
  }

  .rejoindre__carte :global(.bouton) {
    width: 100%;
    margin-top: 8px;
  }
</style>
