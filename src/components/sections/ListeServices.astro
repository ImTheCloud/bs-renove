---
/**
 * La page Services : un sommaire, puis une section par métier.
 * Chaque métier montre un de ses avant/après (le curseur à tirer). Un métier
 * sans avant/après affiche un panneau illustré (son icône en grand) : les
 * 8 métiers ont tous leur section, pour que les liens de la maison dessinée
 * aboutissent toujours.
 */
import { Image } from 'astro:assets';
import Bouton from '../Bouton.astro';
import CurseurAvantApres from '../CurseurAvantApres.astro';
import EntetePage from '../EntetePage.astro';
import Icon from '../Icon.astro';
import { lienDevis } from '~/data/entreprise';
import { nomCategorie } from '~/data/categories';
import { pairesDuService, photoSeuleParService } from '~/data/projets';
import { iconeService, services } from '~/data/services';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.servicesPage;

const aa = textes.accueil.avantApres;
const pairesParService = await Promise.all(services.map((service) => pairesDuService(service.slug)));
---

<EntetePage surtitre={bloc.surtitre} titre={bloc.titre} intro={bloc.intro}>
  <nav class="sommaire" aria-label={bloc.grilleTitre}>
    {
      services.map((service, i) => (
        <a href={`#${service.slug}`}>
          <span class="sommaire__num">{String(i + 1).padStart(2, '0')}</span>
          {service.nom[langue]}
        </a>
      ))
    }
  </nav>
</EntetePage>

<div class="wrap services">
  {
    services.map((service, index) => {
      const paires = pairesParService[index];
      const paire = paires[0];
      return (
        <section id={service.slug} class:list={['service', { 'service--inverse': index % 2 === 1 }]} aria-labelledby={`titre-${service.slug}`}>
          <div class="service__visuel" data-reveal>
            {paire ? (
              <figure class:list={['service__comparaison', { 'service__comparaison--paysage': paire.paysage }]}>
                <CurseurAvantApres langue={langue} id={`curseur-${service.slug}`} ratio={paire.ratio} depart={paire.depart} precision={paire.legende[langue]}>
                  <Image slot="avant" style={`object-position: ${paire.cadrageAvant}`} src={paire.avant} alt={`${aa.avant} : ${paire.legende[langue]}`} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, 90vw" loading="lazy" />
                  <Image slot="apres" style={`object-position: ${paire.cadrageApres}`} src={paire.apres} alt={`${aa.apres} : ${paire.legende[langue]}`} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, 90vw" loading="lazy" />
                </CurseurAvantApres>
                <figcaption class="service__legende">
                  {nomCategorie(paire.categorie, langue)}
                  {paire.commune && <span> · {paire.commune[langue]}</span>}
                </figcaption>
              </figure>
            ) : photoSeuleParService[service.slug] ? (
              <figure class="service__comparaison service__photo-seule">
                <Image
                  src={photoSeuleParService[service.slug]!.image}
                  alt={photoSeuleParService[service.slug]!.legende[langue]}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 30vw, 90vw"
                  loading="lazy"
                />
                <span class="service__badge">{bloc.avantChape}</span>
                <figcaption class="service__legende">{photoSeuleParService[service.slug]!.legende[langue]}</figcaption>
              </figure>
            ) : (
              <div class="service__illustration" aria-hidden="true">
                <Icon nom={iconeService(service.slug)} taille={120} epaisseur={1.1} />
                <span class="manuscrit service__illustration-note">{service.nom[langue]}</span>
              </div>
            )}
          </div>

          <div class="service__texte">
            <span class="service__num">{String(index + 1).padStart(2, '0')} / {String(services.length).padStart(2, '0')}</span>
            <h2 id={`titre-${service.slug}`}>{service.nom[langue]}</h2>
            <p class="service__intro">{service.texte[langue]}</p>

            <div class="service__exemples">
              <span class="service__exemples-titre">{bloc.exemplesTitre}</span>
              <ul>
                {service.exemples[langue].map((exemple) => (
                  <li>
                    <Icon nom="check" taille={16} epaisseur={2.4} />
                    {exemple}
                  </li>
                ))}
              </ul>
            </div>

            <div class="service__actions">
              <Bouton href={lienDevis(langue)} variante="principal" iconeApres="fleche-diag">
                {bloc.devisPour}
              </Bouton>
              {paires.length > 1 && (
                <Bouton href={`${chemin('realisations', langue)}#${paire?.categorie}`} variante="secondaire">
                  {bloc.projetsLies} ({paires.length})
                </Bouton>
              )}
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<style>
  /* --- Sommaire --- */
  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .sommaire a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px 0 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: rgba(245, 242, 236, 0.7);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    transition: background-color 300ms var(--ease), border-color 300ms var(--ease);
  }

  .sommaire a:hover {
    background: var(--color-signal);
    border-color: var(--color-signal);
  }

  .sommaire__num {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-muted);
  }

  /* --- Un métier --- */
  .services {
    display: flex;
    flex-direction: column;
  }

  .service {
    display: grid;
    gap: 32px;
    padding-block: 56px;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-h) + 8px);
  }

  .service__visuel {
    display: grid;
    gap: 10px;
  }

  .service__comparaison {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .service__comparaison--paysage {
    max-width: 640px;
  }

  .service__comparaison :global(.curseur img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service__photo-seule {
    position: relative;
  }

  .service__photo-seule :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-photo);
  }

  .service__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: rgba(245, 242, 236, 0.94);
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .service__legende {
    padding-top: 12px;
    font-size: var(--size-small);
    font-weight: 650;
    color: var(--color-ink);
  }

  .service__legende span {
    font-weight: 500;
    color: var(--color-muted);
  }

  .service__illustration {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-card);
    background:
      linear-gradient(rgba(255, 212, 71, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 212, 71, 0.12) 1px, transparent 1px),
      var(--color-ink);
    background-size: 32px 32px, 32px 32px, auto;
    color: var(--color-signal);
  }

  .service__illustration-note {
    position: absolute;
    left: 24px;
    bottom: 20px;
    font-size: 30px;
    color: var(--color-on-ink);
    transform: rotate(-3deg);
  }

  .service__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .service__num {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .service__texte h2 {
    font-size: clamp(36px, 4.2vw, 64px);
  }

  .service__intro {
    max-width: 48ch;
    font-size: var(--size-lead);
    line-height: 1.5;
  }

  .service__exemples {
    width: 100%;
    padding: 20px 22px;
    background: var(--color-surface);
    border-radius: var(--radius-card-img);
  }

  .service__exemples-titre {
    display: block;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .service__exemples ul {
    display: grid;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service__exemples li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--size-small);
    font-weight: 550;
    color: var(--color-ink);
  }

  .service__exemples li :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }

  @media (min-width: 700px) {
    .service__exemples ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .service {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: 72px;
      padding-block: 96px;
    }

    .service--inverse .service__visuel {
      order: 2;
    }
  }
</style>
