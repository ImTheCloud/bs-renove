---
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { lienDevis } from '~/data/entreprise';
import { listerProjets } from '~/data/projets';
import { services } from '~/data/services';
import { photosServices, aUnePhoto } from '~/data/services-photos';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const textes = t(langue);
const bloc = textes.servicesPage;
const servicesAffiches = services.filter((service) => aUnePhoto(service.slug));

// Chaque service affiche les projets qui lui sont liés, s'il y en a.
const projets = await listerProjets();
const projetsParService = new Map<string, typeof projets>();
for (const projet of projets) {
  const liste = projetsParService.get(projet.data.service) ?? [];
  liste.push(projet);
  projetsParService.set(projet.data.service, liste);
}
---

<div class="wrap services-page">
  <header class="services-page__entete">
    <span class="surtitre">{bloc.surtitre}</span>
    <h1>{bloc.titre}</h1>
    <p class="services-page__intro">{bloc.intro}</p>
  </header>

  <div class="services-page__liste">
    {
      servicesAffiches.map((service, index) => {
        const lies = projetsParService.get(service.slug) ?? [];
        const photos = photosServices[service.slug] ?? [];
        return (
          <section id={service.slug} class:list={['metier', { 'metier--inverse': index % 2 === 1 }]}>
            <div class:list={['metier__visuel', { 'metier__visuel--plusieurs': photos.length > 1 }]}>
              {photos.length > 0 ? (
                photos.map((photo, i) => (
                  <PhotoProjet
                    image={photo}
                    alt={photos.length > 1 ? `${service.nom[langue]} ${i + 1}/${photos.length}` : service.nom[langue]}
                    langue={langue}
                    ratio="4 / 3"
                    arrondi="var(--radius-photo)"
                  />
                ))
              ) : (
                <PhotoProjet alt={service.nom[langue]} langue={langue} ratio="4 / 3" arrondi="var(--radius-photo)" />
              )}
            </div>

            <div class="metier__texte">
              <h2>{service.nom[langue]}</h2>
              <p class="metier__intro">{service.texte[langue]}</p>

              <div class="metier__exemples">
                <span class="metier__exemples-titre">{bloc.exemplesTitre}</span>
                <ul>
                  {service.exemples[langue].map((exemple) => (
                    <li>
                      <span class="metier__coche">
                        <Icon nom="check" taille={15} epaisseur={2.2} />
                      </span>
                      {exemple}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="metier__actions">
                <Bouton
                  href={lienDevis(textes.devisEmail.sujet, textes.devisEmail.corps)}
                  variante="principal"
                  iconeApres="fleche"
                >
                  {bloc.devisPour}
                </Bouton>
                {lies.length > 0 && (
                  <a
                    href={
                      lies.length === 1
                        ? `${chemin('realisations', langue)}${lies[0].id}/`
                        : chemin('realisations', langue)
                    }
                    class="metier__lien"
                    aria-label={
                      lies.length === 1
                        ? `${textes.realisations.voirLeProjet} : ${lies[0].data.titre[langue]}`
                        : `${bloc.projetsLies} : ${service.nom[langue]}`
                    }
                  >
                    {lies.length === 1 ? textes.realisations.voirLeProjet : bloc.projetsLies}
                    <Icon nom="fleche" taille={18} />
                  </a>
                )}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<style>
  .services-page {
    padding-block: 40px 0;
  }

  .services-page__entete {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 620px;
    margin-bottom: 48px;
  }

  .surtitre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .services-page__intro {
    color: var(--color-text);
  }

  .services-page__liste {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .metier {
    display: grid;
    gap: 28px;
    scroll-margin-top: 100px;
  }

  .metier__visuel--plusieurs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .metier__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .metier__intro {
    color: var(--color-text);
  }

  .metier__exemples {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .metier__exemples-titre {
    font-size: var(--size-tiny);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .metier__exemples ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .metier__exemples li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--size-small);
    color: var(--color-ink);
  }

  .metier__coche {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background: var(--color-surface);
    border-radius: var(--radius-pill);
    color: var(--color-accent);
  }

  .metier__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .metier__lien {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap-min);
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .metier__lien:hover {
    text-decoration: underline;
  }

  @media (min-width: 560px) {
    .metier__exemples ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .metier {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 56px;
    }

    /* Une section sur deux inverse photo et texte, pour rythmer la page. */
    .metier--inverse .metier__visuel {
      order: 2;
    }
  }
</style>
