---
import Bouton from '../Bouton.astro';
import CarteProjet from '../CarteProjet.astro';
import CurseurAvantApres from '../CurseurAvantApres.astro';
import Galerie from '../Galerie.astro';
import Icon from '../Icon.astro';
import PhotoProjet from '../PhotoProjet.astro';
import { lienDevis } from '~/data/entreprise';
import { autresProjets, galerieOrdonnee, nomService, type Projet } from '~/data/projets';
import { chemin, t, type Langue } from '~/i18n';

interface Props {
  projet: Projet;
  langue: Langue;
}

const { projet, langue } = Astro.props;
const textes = t(langue);
const bloc = textes.projet;
const donnees = projet.data;

const service = nomService(donnees.service, langue);
const recit = donnees.recit[langue];
const photos = galerieOrdonnee(projet).map((entree) => ({ alt: entree.alt[langue], image: entree.image }));
const suite = await autresProjets(projet.id, 3);

const parties = [
  { titre: bloc.depart, texte: recit.depart },
  { titre: bloc.travaux, texte: recit.travaux },
  { titre: bloc.resultat, texte: recit.resultat },
];
---

<article class="wrap projet">
  <a href={chemin('realisations', langue)} class="projet__retour">
    <span class="projet__retour-fleche"><Icon nom="fleche" taille={18} /></span>
    {bloc.retour}
  </a>

  <header class="projet__entete">
    <h1>{donnees.titre[langue]}</h1>
    <ul class="projet__faits">
      <li>
        <span class="projet__label">{textes.realisations.commune}</span>
        <span class="projet__valeur">{donnees.commune[langue]}</span>
      </li>
      {
        service && (
          <li>
            <span class="projet__label">{textes.realisations.service}</span>
            <span class="projet__valeur">{service}</span>
          </li>
        )
      }
      {
        donnees.dureeSemaines && (
          <li>
            <span class="projet__label">{textes.realisations.duree}</span>
            <span class="projet__valeur">
              {donnees.dureeSemaines} {textes.realisations.semaines}
            </span>
          </li>
        )
      }
    </ul>
  </header>

  <div class="projet__couverture">
    <PhotoProjet
      image={donnees.couverture}
      alt={donnees.couvertureAlt[langue]}
      langue={langue}
      ratio="16 / 9"
      arrondi="var(--radius-photo)"
      prioritaire
    />
  </div>

  {
    donnees.avantApres.length > 0 && (
      <section class="projet__section">
        <h2 class="projet__titre-section">{bloc.avantApres}</h2>
        <div class="projet__comparaisons">
          {donnees.avantApres.map((paire, index) => (
            <figure class="projet__comparaison">
              <CurseurAvantApres
                langue={langue}
                id={`curseur-${projet.id}-${index}`}
                ratio="3 / 4"
                precision={paire.legende[langue]}
              >
                <PhotoProjet
                  slot="avant"
                  image={paire.avant}
                  alt={textes.photos.avant}
                  langue={langue}
                  ratio="3 / 4"
                  ton="moyen"
                />
                <PhotoProjet
                  slot="apres"
                  image={paire.apres}
                  alt={textes.photos.apres}
                  langue={langue}
                  ratio="3 / 4"
                  ton="fonce"
                />
              </CurseurAvantApres>
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="projet__section projet__recit">
    <h2 class="projet__titre-section">{bloc.recitTitre}</h2>
    <div class="projet__parties">
      {
        parties.map((partie) => (
          <div class="projet__partie">
            <h3>{partie.titre}</h3>
            <p>{partie.texte}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    photos.length > 0 && (
      <section class="projet__section">
        <h2 class="projet__titre-section">{bloc.galerie}</h2>
        <Galerie langue={langue} photos={photos} />
      </section>
    )
  }

  <section class="projet__devis">
    <div class="projet__devis-texte">
      <h2>{bloc.similaireTitre}</h2>
      <p>{bloc.similaireTexte}</p>
    </div>
    <Bouton
      href={lienDevis(langue)}
      variante="signal"
      iconeApres="fleche-diag"
      large
    >
      {textes.actions.devis}
    </Bouton>
  </section>

  {
    suite.length > 0 && (
      <section class="projet__section">
        <h2 class="projet__titre-section">{textes.accueil.avantApres.autresProjets}</h2>
        <ul class="projet__suite">
          {suite.map((autre) => (
            <li>
              <CarteProjet projet={autre} langue={langue} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</article>

<style>
  .projet {
    padding-top: calc(var(--header-h) + 32px);
  }

  .projet h1 {
    max-width: 18ch;
  }

  .projet__retour {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap-min);
    font-size: var(--size-tiny);
    font-weight: 600;
    color: var(--color-muted);
    text-decoration: none;
  }

  .projet__retour:hover {
    color: var(--color-ink);
  }

  .projet__retour-fleche {
    display: inline-flex;
    transform: rotate(180deg);
    color: var(--color-ink);
  }

  .projet__entete {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 16px 0 28px;
  }

  .projet__faits {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projet__faits li {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 12px 20px;
    background: var(--color-surface);
    border-radius: var(--radius-small);
  }

  .projet__label {
    font-size: var(--size-tiny);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .projet__valeur {
    font-size: var(--size-small);
    font-weight: 600;
    color: var(--color-ink);
  }

  .projet__section {
    padding-block: var(--section-gap) 0;
  }

  .projet__titre-section {
    margin-bottom: 24px;
    font-size: clamp(30px, 3vw, 44px);
  }

  .projet__comparaisons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 28px;
  }

  .projet__comparaison {
    margin: 0;
  }


  .projet__parties {
    display: grid;
    gap: 24px;
  }

  .projet__partie {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .projet__partie p {
    color: var(--color-text);
  }

  .projet__devis {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: var(--section-gap);
    padding: 32px 24px;
    background: var(--color-ink);
    border-radius: var(--radius-large);
    color: var(--color-on-ink);
  }

  .projet__devis h2 {
    font-size: clamp(30px, 3vw, 44px);
    color: var(--color-on-ink);
  }

  .projet__devis-texte {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 48ch;
  }

  .projet__devis p {
    color: var(--color-on-ink-soft);
  }

  .projet__suite {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .projet__parties {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
  }

  @media (min-width: 640px) {
    .projet__suite {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .projet__devis {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
      padding: 44px 48px;
    }

    .projet__suite {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
