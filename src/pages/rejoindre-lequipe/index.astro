---
import PageRejoindre from '~/components/sections/PageRejoindre.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'fr' as const;
const page = t(langue).pages.rejoindre;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description} enteteSurFonce>
  <PageRejoindre langue={langue} />
</BaseLayout>
