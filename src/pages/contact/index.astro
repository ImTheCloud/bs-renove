---
import PageContact from '~/components/sections/PageContact.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'fr' as const;
const page = t(langue).pages.contact;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <PageContact langue={langue} />
</BaseLayout>
