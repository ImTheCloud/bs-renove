---
import BlocContact from '~/components/sections/BlocContact.astro';
import Hero from '~/components/sections/Hero.astro';
import SectionAvantApres from '~/components/sections/SectionAvantApres.astro';
import SectionPourquoi from '~/components/sections/SectionPourquoi.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'nl' as const;
const page = t(langue).pages.accueil;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <Hero langue={langue} />
  <SectionAvantApres langue={langue} />
  <SectionPourquoi langue={langue} />
  <BlocContact langue={langue} />
</BaseLayout>
