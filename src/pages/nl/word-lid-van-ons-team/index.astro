---
import PageRejoindre from '~/components/sections/PageRejoindre.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'nl' as const;
const page = t(langue).pages.rejoindre;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <PageRejoindre langue={langue} />
</BaseLayout>
