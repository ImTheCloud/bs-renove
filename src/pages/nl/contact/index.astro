---
import SectionDevis from '~/components/accueil/SectionDevis.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'nl' as const;
const page = t(langue).pages.contact;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description} enteteSurFonce>
  <SectionDevis langue={langue} titrePrincipal />
</BaseLayout>
