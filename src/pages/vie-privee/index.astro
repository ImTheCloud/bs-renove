---
import EnConstruction from '~/components/EnConstruction.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'fr' as const;
const textes = t(langue);
const page = textes.pages.viePrivee;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <EnConstruction langue={langue} titre="Vie privée" />
</BaseLayout>
