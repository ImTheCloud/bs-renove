---
import PageLegale from '~/components/sections/PageLegale.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { viePrivee } from '~/data/textes-legaux';
import { t } from '~/i18n';

const langue = 'fr' as const;
const page = t(langue).pages.viePrivee;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <PageLegale langue={langue} titre={page.titre.split(' · ')[0]} blocs={viePrivee} />
</BaseLayout>
