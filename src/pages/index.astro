---
import AvantApres from '~/components/accueil/AvantApres.astro';
import Bandeau from '~/components/accueil/Bandeau.astro';
import Faq from '~/components/accueil/Faq.astro';
import Hero from '~/components/accueil/Hero.astro';
import Methode from '~/components/accueil/Methode.astro';
import Metiers from '~/components/accueil/Metiers.astro';
import Projets from '~/components/accueil/Projets.astro';
import SectionDevis from '~/components/accueil/SectionDevis.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { t } from '~/i18n';

const langue = 'fr' as const;
const page = t(langue).pages.accueil;
---

<BaseLayout langue={langue} titre={page.titre} description={page.description}>
  <Hero langue={langue} />
  <Bandeau langue={langue} />
  <AvantApres langue={langue} />
  <Metiers langue={langue} />
  <Methode langue={langue} />
  <Projets langue={langue} />
  <Faq langue={langue} />
  <SectionDevis langue={langue} />
</BaseLayout>
